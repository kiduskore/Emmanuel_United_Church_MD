</main>

<script>
(function() {
    const photos = <%- JSON.stringify(familyPhotos) %>;
    let currentIndex = 0;

    window.filterFamilyGallery = function(category, btn) {
        const cards = document.querySelectorAll('.family-gallery-card');
        cards.forEach(function(card) {
            if (category === 'all' || card.getAttribute('data-category') === category) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });

        const buttons = document.querySelectorAll('.family-filter-btn');
        buttons.forEach(function(b) {
            b.className = 'family-filter-btn px-4 py-2 rounded-xl text-xs font-heading font-bold uppercase tracking-wider transition-all text-sky-200 hover:text-white hover:bg-white/[0.08] cursor-pointer whitespace-nowrap';
        });
        if (btn) {
            btn.className = 'family-filter-btn px-4 py-2 rounded-xl text-xs font-heading font-bold uppercase tracking-wider transition-all bg-gradient-to-r from-cyan-400 via-sky-500 to-blue-600 text-slate-950 font-black shadow-md cursor-pointer whitespace-nowrap';
        }
    };

    window.openFamilyLightbox = function(index) {
        currentIndex = (index >= 0 && index < photos.length) ? index : 0;
        const modal = document.getElementById('family-lightbox-modal');
        if (!modal) return;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
        renderLightbox();
    };

    window.closeFamilyLightbox = function() {
        const modal = document.getElementById('family-lightbox-modal');
        if (!modal) return;
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
    };

    window.prevFamilyPhoto = function() {
        currentIndex = (currentIndex - 1 + photos.length) % photos.length;
        renderLightbox();
    };

    window.nextFamilyPhoto = function() {
        currentIndex = (currentIndex + 1) % photos.length;
        renderLightbox();
    };

    function renderLightbox() {
        const item = photos[currentIndex];
        const img = document.getElementById('family-lightbox-img');
        const title = document.getElementById('family-lightbox-title');
        const cat = document.getElementById('family-lightbox-category');
        const desc = document.getElementById('family-lightbox-desc');
        const counter = document.getElementById('family-lightbox-counter');

        if (img) {
            img.src = item.src;
            img.alt = item.title;
        }
        if (title) title.textContent = item.title;
        if (cat) cat.textContent = item.categoryLabel;
        if (desc) desc.textContent = item.desc;
        if (counter) counter.textContent = `Photo ${currentIndex + 1} of ${photos.length}`;
    }

    document.addEventListener('keydown', function(e) {
        const modal = document.getElementById('family-lightbox-modal');
        if (!modal || modal.classList.contains('hidden')) return;
        if (e.key === 'Escape') window.closeFamilyLightbox();
        if (e.key === 'ArrowLeft') window.prevFamilyPhoto();
        if (e.key === 'ArrowRight') window.nextFamilyPhoto();
    });

    const modalEl = document.getElementById('family-lightbox-modal');
    if (modalEl) {
        modalEl.addEventListener('click', function(e) {
            if (e.target === modalEl) {
                window.closeFamilyLightbox();
            }
        });
    }

    window.handleFamilyConnectSubmit = async function(e) {
        if (e && e.preventDefault) e.preventDefault();
        const form = document.getElementById('family-connect-form');
        const submitBtn = document.getElementById('family-submit-btn');
        const errorBox = document.getElementById('family-form-error');
        const successBox = document.getElementById('family-form-success');
        if (!form) return;

        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());

        errorBox.classList.add('hidden');
        successBox.classList.add('hidden');
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting...';

        try {
            const res = await fetch('/api/contact', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'x-csrf-token': payload.csrf_token || ''
                },
                body: JSON.stringify(payload)
            });

            if (res.ok) {
                successBox.classList.remove('hidden');
                form.reset();
            } else {
                const errData = await res.json().catch(() => ({}));
                errorBox.textContent = errData.error || 'Could not submit form. Please try again or call (240) 716-2246.';
                errorBox.classList.remove('hidden');
            }
        } catch (err) {
            errorBox.textContent = 'Network error. Please try again or call (240) 716-2246.';
            errorBox.classList.remove('hidden');
        } finally {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Connect With Family Ministry \u2192';
        }
    };
})();
</script>

