<%- include('partials/header', { 
    metaTitle: 'Serving Others | Spiritual Gifts & Ministry Teams | EUCMD',
    metaDesc: 'Put your spiritual gifts into action across worship, hospitality, media, prayer ministry, and community outreach in Maryland.',
    currentPath: '/serving'
}) %>
<%- include('partials/navbar') %>

<main class="min-h-screen text-white pt-24 pb-20 selection:bg-cyan-500 selection:text-black relative overflow-hidden">

    <!-- Ambient Cosmic Spotlight Beams -->
    <div class="pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[550px] bg-gradient-to-b from-cyan-400/20 via-sky-500/10 to-transparent blur-3xl -z-10"></div>
    <div class="pointer-events-none absolute top-1/3 -left-32 w-96 h-96 bg-sky-500/15 rounded-full blur-3xl -z-10"></div>
    <div class="pointer-events-none absolute top-2/3 -right-32 w-96 h-96 bg-cyan-400/15 rounded-full blur-3xl -z-10"></div>

    <!-- Hero Header -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-10 text-center">
        <div class="azure-glass-shell p-8 sm:p-12 relative overflow-hidden">
            <div class="diamond-glint" style="top: 2rem; right: 3rem;"></div>
            
            <div class="azure-pill inline-flex items-center gap-2 mb-4">
                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
                <span>Track 11 · Ephesians 2:10</span>
            </div>

            <h1 class="text-4xl sm:text-6xl font-heading font-black tracking-tight uppercase text-white mb-4">
                Discover Your Calling.
            </h1>

            <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
                Serve according to your spiritual gifts and help someone else grow in Jesus.
            </p>
        </div>
    </section>

    <!-- Main Study Content Shell -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
        <div class="azure-glass-shell p-8 sm:p-12 relative overflow-hidden space-y-10">
            <div class="diamond-glint" style="bottom: 2rem; right: 2rem;"></div>

            <!-- Header & Read Time -->
            <div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 pb-6">
                <div>
                    <span class="px-3 py-1 rounded-full bg-cyan-400/10 border border-cyan-400/30 text-cyan-300 font-mono text-xs uppercase tracking-wider">
                        <%= typeof t !== 'undefined' ? t('common.readTime', { min: '3' }) : '3 MIN READ' %>
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-heading font-bold text-white uppercase tracking-tight mt-3">
                        <%= typeof t !== 'undefined' ? t('serving.title') : 'Serving in the Body' %>
                    </h2>
                </div>
                <div class="w-24 h-1 rounded-full cyan-progress-fill"></div>
            </div>

            <!-- Section 1 -->
            <div class="space-y-4">
                <h3 class="text-xl font-heading font-bold uppercase text-white flex items-center gap-2">
                    <span class="text-cyan-400">✦</span>
                    <span>Everyone is Called to be a Disciple</span>
                </h3>
                <div class="azure-inner-card p-6 border-l-4 border-l-cyan-400 my-4">
                    <p class="text-cyan-200 text-sm sm:text-base italic leading-relaxed">
                        <%= typeof t !== 'undefined' ? t('serving.section1.q1') : '"For we are God’s handiwork, created in Christ Jesus to do good works, which God prepared in advance for us to do." (Ephesians 2:10)' %>
                    </p>
                </div>
                <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
                    Not everyone will be a leader. Not everyone will serve in the same way. But everyone is called to be a disciple. That is how disciples make disciples.
                </p>
            </div>

            <!-- Section 2 -->
            <div class="space-y-4 pt-4 border-t border-white/10">
                <h3 class="text-xl font-heading font-bold uppercase text-white flex items-center gap-2">
                    <span class="text-cyan-400">✦</span>
                    <span>How You Can Serve</span>
                </h3>
                <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
                    Some may lead. Some may teach. Some may worship. Some may serve behind the scenes on audiovisual & tech. Some may welcome guests with warm hospitality. Some may pray and intercede. Every gift matters to the health of Christ's body.
                </p>
            </div>

            <!-- CTA Button -->
            <div class="pt-6">
                <a href="/join" class="azure-primary-btn w-full block text-center py-4 text-sm uppercase tracking-wider">
                    <%= typeof t !== 'undefined' ? t('serving.ctaBtn') : 'Join a Serving Team' %> &rarr;
                </a>
            </div>

        </div>
    </section>

    <!-- Join Us Section -->
    <%- include('partials/join-section') %>
</main>

<%- include('partials/footer') %>
