let currentPageLightboxIndex = 0;

function openPageLightbox(index) {
    currentPageLightboxIndex = index;
    updatePageLightboxContent();
    const modal = document.getElementById('page-lightbox-modal');
    modal.classList.remove('opacity-0', 'pointer-events-none');
    document.body.style.overflow = 'hidden';
}

function closePageLightbox() {
    const modal = document.getElementById('page-lightbox-modal');
    modal.classList.add('opacity-0', 'pointer-events-none');
    document.body.style.overflow = '';
}

function closePageLightboxOnBackdrop(e) {
    if (e.target.id === 'page-lightbox-modal') {
        closePageLightbox();
    }
}

function updatePageLightboxContent() {
    const item = pageGalleryPhotos[currentPageLightboxIndex];
    if (!item) return;
    document.getElementById('page-lightbox-img').src = item.src;
    document.getElementById('page-lightbox-img').alt = item.title;
    document.getElementById('page-lightbox-title').textContent = item.title;
    document.getElementById('page-lightbox-desc').textContent = item.desc;
    document.getElementById('page-lightbox-category').textContent = item.category;
    document.getElementById('page-lightbox-counter').textContent = (currentPageLightboxIndex + 1) + ' / ' + pageGalleryPhotos.length;
}

function nextPageLightboxPhoto(e) {
    if (e) e.stopPropagation();
    currentPageLightboxIndex = (currentPageLightboxIndex + 1) % pageGalleryPhotos.length;
    updatePageLightboxContent();
}

function prevPageLightboxPhoto(e) {
    if (e) e.stopPropagation();
    currentPageLightboxIndex = (currentPageLightboxIndex - 1 + pageGalleryPhotos.length) % pageGalleryPhotos.length;
    updatePageLightboxContent();
}

document.addEventListener('keydown', (e) => {
    const modal = document.getElementById('page-lightbox-modal');
    if (!modal || modal.classList.contains('pointer-events-none')) return;
    if (e.key === 'Escape') closePageLightbox();
    if (e.key === 'ArrowRight') nextPageLightboxPhoto();
    if (e.key === 'ArrowLeft') prevPageLightboxPhoto();
});

function filterGalleryCategory(cat, btn) {
    document.querySelectorAll('.gallery-filter-btn').forEach(b => {
        b.className = 'gallery-filter-btn px-5 py-2.5 rounded-full text-xs font-heading font-bold uppercase tracking-wider transition-all bg-white/[0.06] border border-sky-400/20 text-sky-200 hover:bg-white/[0.12] hover:text-white cursor-pointer';
    });
    btn.className = 'gallery-filter-btn px-5 py-2.5 rounded-full text-xs font-heading font-bold uppercase tracking-wider transition-all bg-cyan-400 text-slate-950 shadow-[0_0_15px_rgba(0,229,255,0.5)] cursor-pointer';

    const cards = document.querySelectorAll('.gallery-item-card');
    cards.forEach(card => {
        if (cat === 'all' || card.getAttribute('data-category') === cat) {
            card.style.display = 'block';
        } else {
            card.style.display = 'none';
        }
    });
}
