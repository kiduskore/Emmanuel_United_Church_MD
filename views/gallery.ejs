        <div class="absolute top-1/3 -right-40 w-[650px] h-[650px] bg-cyan-400/10 rounded-full filter blur-[160px]"></div>
        <div class="absolute bottom-10 left-1/4 w-[600px] h-[600px] bg-blue-700/12 rounded-full filter blur-[150px]"></div>
    </div>

