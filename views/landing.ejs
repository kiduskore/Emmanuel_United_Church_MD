    <!-- Core Interactive Client Script for Polished Homepage -->
    <script>
    (function() {
        // --- 1. Live Sunday Worship Countdown Timer ---
        function updateSundayCountdown() {
            const countdownEl = document.getElementById('hero-sunday-countdown');
            if (!countdownEl) return;

            const now = new Date();
            // Calculate next Sunday at 10:30 AM EST (America/New_York)
            // EST is UTC-5 (or EDT UTC-4). Using client relative calendar arithmetic:
            const dayOfWeek = now.getDay(); // 0 is Sunday
            const hours = now.getHours();
            const minutes = now.getMinutes();

            // Check if service is live right now (Sunday between 10:30 AM and 1:30 PM)
            if (dayOfWeek === 0 && (hours > 10 || (hours === 10 && minutes >= 30)) && hours < 14) {
                countdownEl.innerHTML = '<span class="text-rose-400 animate-pulse font-bold">🔴 Live Worship Now in Session</span>';
                return;
            }

            let daysUntilSunday = (7 - dayOfWeek) % 7;
            if (daysUntilSunday === 0 && (hours >= 14)) {
                daysUntilSunday = 7;
            }

            const targetSunday = new Date(now);
            targetSunday.setDate(now.getDate() + daysUntilSunday);
            targetSunday.setHours(10, 30, 0, 0);

            let diffMs = targetSunday - now;
            if (diffMs < 0) {
                targetSunday.setDate(targetSunday.getDate() + 7);
                diffMs = targetSunday - now;
            }

            const totalSecs = Math.floor(diffMs / 1000);
            const d = Math.floor(totalSecs / 86400);
            const h = Math.floor((totalSecs % 86400) / 3600);
            const m = Math.floor((totalSecs % 3600) / 60);
            const s = totalSecs % 60;

            const pad = (n) => String(n).padStart(2, '0');
            countdownEl.textContent = `in ${d}d ${pad(h)}h ${pad(m)}m ${pad(s)}s · 10:30 AM`;
        }

        setInterval(updateSundayCountdown, 1000);
        updateSundayCountdown();

        // --- 2. Copy To Clipboard with Modern Floating Toast ---
        let toastTimeout = null;
        window.copyToClipboard = function(text, label) {
            if (!navigator.clipboard) {
                prompt("Copy below:", text);
                return;
            }
            navigator.clipboard.writeText(text).then(() => {
                const toast = document.getElementById('global-copy-toast');
                const msg = document.getElementById('copy-toast-msg');
                if (toast && msg) {
                    msg.textContent = `Copied ${label || text} to clipboard!`;
                    toast.classList.remove('hidden');
                    // Force reflow
                    void toast.offsetWidth;
                    toast.classList.remove('translate-y-3', 'opacity-0');
                    toast.classList.add('translate-y-0', 'opacity-100');

                    clearTimeout(toastTimeout);
                    toastTimeout = setTimeout(() => {
                        toast.classList.remove('translate-y-0', 'opacity-100');
                        toast.classList.add('translate-y-3', 'opacity-0');
                        setTimeout(() => toast.classList.add('hidden'), 300);
                    }, 3500);
                }
            }).catch(() => {
                prompt("Copy below:", text);
            });
        };

        // --- 3. Interactive Church Photo Gallery & Lightbox (Synced with /gallery 42-photo archive) ---
        const galleryPhotos = <%- JSON.stringify(homeGalleryPhotos.map((p, idx) => ({
            src: p.src,
            title: "Emmanuel United Church — " + p.badge,
            category: p.badge,
            desc: "Authentic life at EUCMD in Silver Spring, Maryland (Photo " + (idx + 1) + " of " + homeGalleryPhotos.length + ")."
        }))) %>;

        let currentLightboxIndex = 0;

        window.filterGallery = function(category, btn) {
            const cards = document.querySelectorAll('.gallery-card');
            cards.forEach(card => {
                if (category === 'all' || card.getAttribute('data-category') === category) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });

            // Update active button styling cleanly to match /gallery
            const filterBtns = document.querySelectorAll('.gallery-filter-btn');
            filterBtns.forEach(b => {
                b.className = 'gallery-filter-btn px-5 py-2.5 rounded-full text-xs font-heading font-bold uppercase tracking-wider transition-all bg-white/[0.06] border border-sky-400/25 text-sky-200 hover:text-white hover:bg-white/[0.12] hover:border-cyan-400/50 cursor-pointer';
            });
            if (btn) {
                btn.className = 'gallery-filter-btn px-5 py-2.5 rounded-full text-xs font-heading font-bold uppercase tracking-wider transition-all bg-gradient-to-r from-cyan-400 via-sky-500 to-blue-600 text-slate-950 font-black shadow-[0_0_20px_rgba(0,229,255,0.4)] cursor-pointer';
            }
        };

        window.openGalleryLightbox = function(index) {
            currentLightboxIndex = (index >= 0 && index < galleryPhotos.length) ? index : 0;
            renderLightboxPhoto();
            const modal = document.getElementById('gallery-lightbox-modal');
            if (modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                document.body.style.overflow = 'hidden';
            }
        };

        window.openPosterLightbox = function(src, title) {
            const modal = document.getElementById('gallery-lightbox-modal');
            const img = document.getElementById('lightbox-img');
            const titleEl = document.getElementById('lightbox-title');
            const descEl = document.getElementById('lightbox-desc');
            const catEl = document.getElementById('lightbox-category');
            const counterEl = document.getElementById('lightbox-counter');
            const fullLink = document.getElementById('lightbox-full-link');
            if (!modal || !img) return;
            img.src = src;
            img.alt = title || 'Event Poster';
            if (titleEl) titleEl.textContent = title || 'Coming Soon Event Flyer';
            if (descEl) descEl.textContent = 'የመጨረሻው ዘመን ትምህርታዊ ኮንፈረንስ · Nov 13, 14 & 15, 2026';
            if (catEl) catEl.textContent = 'Conference Flyer';
            if (counterEl) counterEl.textContent = 'Official Poster';
            if (fullLink) fullLink.href = src;
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
        };

        window.closeGalleryLightbox = function() {
            const modal = document.getElementById('gallery-lightbox-modal');
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                document.body.style.overflow = '';
            }
        };

        window.prevGalleryPhoto = function() {
            currentLightboxIndex = (currentLightboxIndex - 1 + galleryPhotos.length) % galleryPhotos.length;
            renderLightboxPhoto();
        };

        window.nextGalleryPhoto = function() {
            currentLightboxIndex = (currentLightboxIndex + 1) % galleryPhotos.length;
            renderLightboxPhoto();
        };

        function renderLightboxPhoto() {
            const item = galleryPhotos[currentLightboxIndex];
            if (!item) return;

            const img = document.getElementById('lightbox-img');
            const title = document.getElementById('lightbox-title');
            const desc = document.getElementById('lightbox-desc');
            const cat = document.getElementById('lightbox-category');
            const counter = document.getElementById('lightbox-counter');
            const fullLink = document.getElementById('lightbox-full-link');

            if (img) {
                img.onerror = function() {
                    if (item.fallbackSrc && img.src !== item.fallbackSrc) {
                        img.src = item.fallbackSrc;
                    }
                };
                img.src = item.src;
                img.alt = item.title;
            }
            if (title) title.textContent = item.title;
            if (desc) desc.textContent = item.desc;
            if (cat) cat.textContent = item.category;
            if (counter) counter.textContent = `Photo ${currentLightboxIndex + 1} of ${galleryPhotos.length}`;
            if (fullLink) fullLink.href = item.src;
        }

        // Keyboard navigation for Lightbox
        document.addEventListener('keydown', function(e) {
            const modal = document.getElementById('gallery-lightbox-modal');
            if (modal && !modal.classList.contains('hidden')) {
                if (e.key === 'Escape') window.closeGalleryLightbox();
                if (e.key === 'ArrowLeft') window.prevGalleryPhoto();
                if (e.key === 'ArrowRight') window.nextGalleryPhoto();
            }
        });
    })();
    </script>
    </main>

