    <!-- ============================================================ -->
    <!-- FULL-RESOLUTION LIGHTBOX MODAL                               -->
    <!-- ============================================================ -->
    <div id="family-lightbox-modal" class="fixed inset-0 z-[200] hidden items-center justify-center p-3 sm:p-6 bg-black/92 backdrop-blur-3xl transition-opacity duration-300" role="dialog" aria-modal="true" aria-label="Family Ministry Photo Lightbox">
        <div class="relative max-w-5xl w-full azure-glass-shell border border-sky-400/40 rounded-3xl overflow-hidden shadow-2xl flex flex-col">
            <!-- Modal Header -->
            <div class="flex items-center justify-between p-4 sm:px-6 border-b border-sky-400/20 bg-[#060d1d]/90">
                <div>
                    <span id="family-lightbox-category" class="text-[11px] font-heading font-bold uppercase tracking-widest text-cyan-300 block"></span>
                    <h3 id="family-lightbox-title" class="text-base sm:text-lg font-heading font-bold text-white"></h3>
                </div>
                <button type="button" onclick="window.closeFamilyLightbox && window.closeFamilyLightbox()" class="p-2 rounded-full hover:bg-white/10 text-sky-200 hover:text-white transition-colors cursor-pointer" aria-label="Close photo view">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
