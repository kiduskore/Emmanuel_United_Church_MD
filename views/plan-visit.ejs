<%- include('partials/header', { 
    metaTitle: 'Plan Your Visit | Emmanuel United Church of Maryland',
    metaDesc: 'Plan your visit to Emmanuel United Church of Maryland in Silver Spring, MD. Register your family, meet our pastors, find parking details, and experience transformative worship.',
    currentPath: '/plan-visit'
}) %>

<%- include('partials/navbar') %>

<main id="main-content" class="min-h-screen text-white selection:bg-cyan-500 selection:text-slate-950 pt-24 pb-20 relative overflow-hidden">

    <!-- Ambient Celestial Azure Aurora Spotlight Flares -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
        <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[900px] h-[600px] bg-sky-500/18 rounded-full filter blur-[150px]"></div>
        <div class="absolute top-1/3 -right-40 w-[600px] h-[600px] bg-cyan-400/14 rounded-full filter blur-[160px]"></div>
        <div class="absolute bottom-10 left-1/4 w-[550px] h-[550px] bg-blue-700/16 rounded-full filter blur-[150px]"></div>
    </div>

    <!-- Hero Header -->
    <section class="py-16 sm:py-20 text-center relative overflow-hidden z-10">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="inline-flex items-center gap-2 px-5 py-2 rounded-full bg-white/[0.08] border border-sky-400/30 text-xs font-heading font-bold uppercase tracking-widest text-cyan-300 mb-6 backdrop-blur-xl shadow-lg">
                <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse shadow-[0_0_10px_#00e5ff]"></span>
                <span class="text-white">Welcome Home · እንኳን ደህና መጡ</span>
            </div>
            <h1 class="text-4xl sm:text-6xl md:text-7xl font-heading font-black tracking-tight uppercase text-white mb-6">
                Plan Your Visit
            </h1>
            <p class="text-base sm:text-xl text-sky-100/90 max-w-2xl mx-auto font-sans leading-relaxed text-balance">
                We're excited to meet you! Register your visit so our pastoral care and welcome team can greet your family, guide you around, and help you feel right at home.
            </p>
        </div>
    </section>

    <!-- Main Content Grid -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
            
            <!-- Left: Interactive Visit Form (7 cols) -->
            <div class="lg:col-span-7">
                <div class="azure-glass-shell rounded-[2.5rem] p-6 sm:p-10 border border-sky-400/30 shadow-2xl relative overflow-hidden">
                    <div class="diamond-glint top-6 right-6 hidden sm:block"></div>
                    
                    <div class="mb-6">
                        <span class="text-xs font-heading font-bold uppercase tracking-widest text-cyan-300">Guest Registration</span>
                        <h2 class="text-2xl sm:text-3xl font-heading font-black uppercase text-white mt-1">
                            Let Us Know You're Coming
                        </h2>
                        <p class="text-xs sm:text-sm text-sky-200/80 font-sans mt-1">
                            Takes less than 60 seconds. We'll have a welcome gift ready for you at the welcome desk!
                        </p>
                    </div>

                    <!-- Form Container -->
                    <div id="plan-visit-page-container">
                        <form id="plan-visit-page-form" onsubmit="window.handlePageVisitSubmit && window.handlePageVisitSubmit(event); return false;" class="space-y-4">
                            <input type="hidden" name="csrf_token" value="<%= typeof csrf_token !== 'undefined' ? csrf_token : '' %>">

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-heading font-bold uppercase tracking-wider text-sky-200 mb-1.5" for="pv-name">Full Name *</label>
                                    <input type="text" id="pv-name" name="name" required placeholder="e.g. Dawit Bekele" class="w-full px-4 py-3.5 rounded-xl border border-sky-400/30 bg-[#08152e]/80 text-white text-xs sm:text-sm focus:border-cyan-400 focus:outline-none transition-all placeholder:text-sky-300/40">
                                </div>
                                <div>
                                    <label class="block text-xs font-heading font-bold uppercase tracking-wider text-sky-200 mb-1.5" for="pv-email">Email Address *</label>
                                    <input type="email" id="pv-email" name="email" required placeholder="dawit@example.com" class="w-full px-4 py-3.5 rounded-xl border border-sky-400/30 bg-[#08152e]/80 text-white text-xs sm:text-sm focus:border-cyan-400 focus:outline-none transition-all placeholder:text-sky-300/40">
                                </div>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-heading font-bold uppercase tracking-wider text-sky-200 mb-1.5" for="pv-phone">Phone Number (Optional)</label>
                                    <input type="tel" id="pv-phone" name="phone" placeholder="(240) 716-2246" class="w-full px-4 py-3.5 rounded-xl border border-sky-400/30 bg-[#08152e]/80 text-white text-xs sm:text-sm focus:border-cyan-400 focus:outline-none transition-all placeholder:text-sky-300/40">
                                </div>
                                <div>
                                    <label class="block text-xs font-heading font-bold uppercase tracking-wider text-sky-200 mb-1.5" for="pv-service">Service to Attend *</label>
                                    <select id="pv-service" name="service" required class="w-full px-4 py-3.5 rounded-xl border border-sky-400/30 bg-[#08152e]/90 text-white text-xs sm:text-sm focus:border-cyan-400 focus:outline-none transition-all">
                                        <option value="sunday_1030">Sunday Worship (10:30 AM · 12604 New Hampshire Ave)</option>
                                        <option value="friday_1900">Friday PRAYER and WORSHIP (07:00 PM · 914 Silver Spring Ave)</option>
                                        <option value="wednesday_1100">Wednesday Prayer (11:00 AM · 914 Silver Spring Ave)</option>
                                    </select>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-heading font-bold uppercase tracking-wider text-sky-200 mb-1.5" for="pv-party">Number in Party</label>
                                    <select id="pv-party" name="party_size" class="w-full px-4 py-3.5 rounded-xl border border-sky-400/30 bg-[#08152e]/90 text-white text-xs sm:text-sm focus:border-cyan-400 focus:outline-none transition-all">
                                        <option value="1">Just Me (1)</option>
                                        <option value="2">2 People</option>
                                        <option value="3">3 People</option>
                                        <option value="4+">4 or More (Family / Group)</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-heading font-bold uppercase tracking-wider text-sky-200 mb-1.5" for="pv-kids">Bringing Children? (Ages 4–11)</label>
                                    <select id="pv-kids" name="children_info" class="w-full px-4 py-3.5 rounded-xl border border-sky-400/30 bg-[#08152e]/90 text-white text-xs sm:text-sm focus:border-cyan-400 focus:outline-none transition-all">
                                        <option value="no">No children</option>
                                        <option value="yes_kids_church">Yes, will join Kingdom Kids</option>
                                        <option value="yes_with_us">Yes, will sit with us in Sanctuary</option>
                                    </select>
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-heading font-bold uppercase tracking-wider text-sky-200 mb-1.5" for="pv-notes">Questions, Prayer Needs, or Special Accommodations</label>
                                <textarea id="pv-notes" name="notes" rows="3" placeholder="Let us know if you need parking assistance, English translation headset, wheelchair access, or specific prayer..." class="w-full px-4 py-3 rounded-xl border border-sky-400/30 bg-[#08152e]/80 text-white text-xs sm:text-sm focus:border-cyan-400 focus:outline-none transition-all placeholder:text-sky-300/40"></textarea>
                            </div>

                            <div id="pv-form-error" class="hidden p-3.5 rounded-xl bg-red-500/20 border border-red-500/40 text-red-200 text-xs font-medium"></div>

                            <div class="pt-3 flex flex-col sm:flex-row items-center justify-between gap-3">
                                <button type="submit" id="pv-submit-btn" class="w-full sm:w-auto px-8 py-4 rounded-full azure-primary-btn text-white font-heading font-bold text-xs uppercase tracking-wider shadow-xl transition-all active:scale-95 flex items-center justify-center gap-2 cursor-pointer">
                                    <span>Register My Visit</span>
                                    <span aria-hidden="true">&rarr;</span>
                                </button>
                                <button type="button" onclick="window.downloadServiceIcs && window.downloadServiceIcs()" class="w-full sm:w-auto px-5 py-3.5 rounded-full azure-pill text-sky-200 hover:text-white font-heading text-xs font-bold uppercase tracking-wider transition-all flex items-center justify-center gap-2 cursor-pointer">
                                    <svg class="w-4 h-4 text-cyan-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                    <span>Add to Calendar (.ics)</span>
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Instant Success Confirmation Card -->
                    <div id="plan-visit-page-success" class="hidden space-y-6 text-center py-6">
                        <div class="w-16 h-16 rounded-2xl bg-cyan-500/20 text-cyan-300 border border-cyan-400/40 flex items-center justify-center mx-auto text-3xl font-bold shadow-[0_0_20px_rgba(0,229,255,0.4)]">
                            ✓
                        </div>
                        <div>
                            <span class="text-xs font-heading font-bold uppercase tracking-widest text-cyan-300">Registration Confirmed</span>
                            <h3 class="text-2xl sm:text-3xl font-heading font-bold uppercase text-white mt-1">We Can't Wait To Welcome You!</h3>
                            <p class="text-xs sm:text-sm text-sky-200/90 mt-2 max-w-lg mx-auto font-sans leading-relaxed" id="pv-success-msg">
                                Your visit has been registered with our pastoral care and hospitality team.
                            </p>
                        </div>

                        <!-- Helpful Visit Checklist Grid -->
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-left pt-2 font-sans">
                            <div class="p-4 rounded-2xl azure-inner-card border border-sky-400/20">
                                <div class="text-xs font-bold text-white mb-1">🚗 Free On-Site Parking</div>
                                <p class="text-[11px] text-sky-200/70 leading-tight">Ample parking directly adjacent to the main building entrance.</p>
                            </div>
                            <div class="p-4 rounded-2xl azure-inner-card border border-sky-400/20">
                                <div class="text-xs font-bold text-white mb-1">👋 Welcome Host</div>
                                <p class="text-[11px] text-sky-200/70 leading-tight">Look for greeters at the foyer holding your welcome gift.</p>
                            </div>
                            <div class="p-4 rounded-2xl azure-inner-card border border-sky-400/20">
                                <div class="text-xs font-bold text-white mb-1">👶 Kingdom Kids Check-In</div>
                                <p class="text-[11px] text-sky-200/70 leading-tight">Children check-in opens at 10:15 AM for a fun, Bible lesson.</p>
                            </div>
                        </div>

                        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
                            <button type="button" onclick="window.downloadServiceIcs && window.downloadServiceIcs()" class="w-full sm:w-auto px-6 py-3.5 rounded-full azure-primary-btn text-white font-heading font-bold text-xs uppercase tracking-wider shadow-lg transition-all">
                                Download Calendar Reminder (.ics)
                            </button>
                            <a href="https://maps.google.com/?q=12604+New+Hampshire+Ave,+Silver+Spring,+MD+20904" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto px-5 py-3.5 rounded-full azure-pill text-sky-200 hover:text-white font-heading text-xs font-bold uppercase tracking-wider transition-all">
                                Open in Google Maps &rarr;
                            </a>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Right: What to Expect & Service Details (5 cols) -->
            <div class="lg:col-span-5 space-y-6">
                
                <!-- Sanctuary Service Schedule Card -->
                <div class="p-7 rounded-[2.2rem] azure-glass-shell border border-sky-400/30 shadow-2xl space-y-4">
                    <span class="px-3.5 py-1 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-400/30 text-xs font-heading font-bold uppercase tracking-wider">
                        Worship Gatherings
                    </span>
                    <h3 class="text-xl sm:text-2xl font-heading font-bold uppercase text-white">Service Times & Locations</h3>

                    <div class="space-y-3 font-sans text-xs">
                        <div class="p-4 rounded-2xl azure-inner-card border border-sky-400/20 space-y-1">
                            <div class="flex items-center justify-between">
                                <span class="font-heading font-bold text-cyan-300 uppercase">Sunday Corporate Worship</span>
                                <span class="font-mono text-white text-[11px] font-bold">10:30 AM EST</span>
                            </div>
                            <p class="text-sky-200/80">12604 New Hampshire Ave, Silver Spring, MD 20904</p>
                            <p class="text-[11px] text-sky-300/60">Live Sanctuary Praise, The Word & Kingdom Kids</p>
                        </div>

                        <div class="p-4 rounded-2xl azure-inner-card border border-sky-400/20 space-y-1">
                            <div class="flex items-center justify-between">
                                <span class="font-heading font-bold text-amber-300 uppercase">Friday Prayer & Worship</span>
                                <span class="font-mono text-white text-[11px] font-bold">07:00 PM EST</span>
                            </div>
                            <p class="text-sky-200/80">914 Silver Spring Ave, Suite 204B, Silver Spring, MD 20910</p>
                            <p class="text-[11px] text-amber-300/60">Intercessory Prayer, Fasting & Personal Ministry</p>
                        </div>

                        <div class="p-4 rounded-2xl azure-inner-card border border-sky-400/20 space-y-1">
                            <div class="flex items-center justify-between">
                                <span class="font-heading font-bold text-purple-300 uppercase">Wednesday Midweek Prayer</span>
                                <span class="font-mono text-white text-[11px] font-bold">11:00 AM EST</span>
                            </div>
                            <p class="text-sky-200/80">914 Silver Spring Ave, Suite 204B, Silver Spring, MD 20910</p>
                        </div>
                    </div>
                </div>

                <!-- What to Expect FAQ -->
                <div class="p-7 rounded-[2.2rem] azure-glass-shell border border-sky-400/30 shadow-2xl space-y-4">
                    <h3 class="text-lg font-heading font-bold uppercase text-white tracking-wide">
                        What to Expect as a First-Time Guest
                    </h3>

                    <div class="space-y-3 font-sans text-xs text-sky-200/80">
                        <div class="border-b border-sky-400/20 pb-3">
                            <strong class="text-white block font-heading uppercase text-xs mb-0.5">What should I wear?</strong>
                            Come as you are! You will see people in casual attire, business suits, and beautiful traditional Ethiopian attire (Habesha Kemis / Netela).
                        </div>
                        <div class="border-b border-sky-400/20 pb-3">
                            <strong class="text-white block font-heading uppercase text-xs mb-0.5">Is translation available?</strong>
                            Yes! Wireless headsets with live English translation are available at the audio console for any Amharic sermon portions.
                        </div>
                        <div>
                            <strong class="text-white block font-heading uppercase text-xs mb-0.5">What about my kids?</strong>
                            Kingdom Kids children ministry provides safe, age-appropriate Bible lessons and crafts for children ages 4 to 11.
                        </div>
                    </div>

                    <div class="pt-2">
                        <a href="https://www.youtube.com/@emmanuelunitedchurchmd8566" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-xs font-heading font-bold uppercase tracking-wider text-red-400 hover:text-white transition-colors">
                            <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                            <span>Can't Attend In Person? Watch Live on YouTube &rarr;</span>
                        </a>
                    </div>
                </div>

            </div>

        </div>
    </div>

</main>

<script>
window.handlePageVisitSubmit = async function(e) {
    if (e && e.preventDefault) e.preventDefault();
    const form = document.getElementById('plan-visit-page-form');
    const submitBtn = document.getElementById('pv-submit-btn');
    const errorBox = document.getElementById('pv-form-error');
    const formContainer = document.getElementById('plan-visit-page-container');
    const successView = document.getElementById('plan-visit-page-success');
    const successMsg = document.getElementById('pv-success-msg');

    if (!form) return;
    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());

    if (errorBox) errorBox.classList.add('hidden');
    if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>Registering...</span>';
    }

    try {
        const res = await fetch('/api/plan-visit', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'x-csrf-token': payload.csrf_token || ''
            },
            body: JSON.stringify(payload)
        });

        if (res.ok) {
            if (formContainer) formContainer.classList.add('hidden');
            if (successView) successView.classList.remove('hidden');
            if (successMsg) {
                const serviceLabel = payload.service === 'sunday_1030' 
                    ? 'Sunday at 10:30 AM (12604 New Hampshire Ave)' 
                    : (payload.service === 'friday_1900' ? 'Friday at 07:00 PM (914 Silver Spring Ave)' : 'Wednesday at 11:00 AM');
                successMsg.textContent = `Thank you, ${payload.name}! We've saved your spot for ${serviceLabel}. Our welcome team looks forward to meeting you!`;
            }
        } else {
            const errData = await res.json().catch(() => ({}));
            if (errorBox) {
                errorBox.textContent = errData.error || 'Failed to submit visit request. Please try again.';
                errorBox.classList.remove('hidden');
            }
        }
    } catch (err) {
        if (errorBox) {
            errorBox.textContent = 'Network error. Please try again or call our office at (240) 716-2246.';
            errorBox.classList.remove('hidden');
        }
    } finally {
        if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Register My Visit</span> &rarr;';
        }
    }
};
</script>

<%- include('partials/footer') %>
