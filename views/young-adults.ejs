<script>
(function() {
    // 1. Hydrate Live Discipleship Resources from /api/resources
    async function loadYaResources() {
        const container = document.getElementById('ya-public-resources');
        if (!container) return;

        try {
            const res = await fetch('/api/resources');
            if (!res.ok) throw new Error('Failed to load resources');
            const items = await res.json();

            if (!Array.isArray(items) || items.length === 0) {
                container.innerHTML = '<div class="col-span-full text-center py-10 text-slate-300 text-sm">More discipleship study guides are coming soon.</div>';
                return;
            }

            container.innerHTML = '';
            items.forEach(function(item) {
                const card = document.createElement('div');
                card.className = 'azure-glass-shell p-7 flex flex-col justify-between hover:border-cyan-400/60 transition-all';

                const top = document.createElement('div');
                const cat = document.createElement('span');
                cat.className = 'font-mono text-[11px] font-bold uppercase tracking-widest text-cyan-300 block mb-2';
                cat.textContent = item.category || 'Resource';

                const title = document.createElement('h3');
                title.className = 'text-xl font-heading font-bold text-white mb-2.5 leading-snug';
                title.textContent = item.title || 'Discipleship Resource';

                const desc = document.createElement('p');
                desc.className = 'text-xs sm:text-sm text-slate-300 leading-relaxed mb-6';
                desc.textContent = item.description || 'Study guide for personal and Life Pod discipleship.';

                top.appendChild(cat);
                top.appendChild(title);
                top.appendChild(desc);

                const link = document.createElement('a');
                link.href = item.file_url || '#';
                link.target = '_blank';
                link.rel = 'noopener noreferrer';
                link.className = 'pt-4 border-t border-white/10 inline-flex items-center justify-between text-xs font-mono font-bold uppercase tracking-wider text-cyan-300 hover:text-white transition-colors';
                link.innerHTML = '<span>Open Resource</span><span>&rarr;</span>';

                card.appendChild(top);
                card.appendChild(link);
                container.appendChild(card);
            });
        } catch (err) {
            container.innerHTML = '<div class="col-span-full text-center py-8 space-y-3"><p class="text-sm text-rose-300">Unable to load discipleship resources right now.</p><button type="button" onclick="window.reloadYaResources && window.reloadYaResources()" class="px-5 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold uppercase tracking-wider cursor-pointer">Retry</button></div>';
        }
    }
    window.reloadYaResources = loadYaResources;
    loadYaResources();

    // 2. Priority Notification Modal for Knowing God (Isaiah 40:28)
    window.openKnowingNotifyModal = function() {
        const modal = document.getElementById('knowing-notify-modal');
        const form = document.getElementById('knowing-notify-form');
        const success = document.getElementById('knowing-notify-success');
        const errorBox = document.getElementById('knowing-form-error');
        if (!modal) return;
        if (form) form.classList.remove('hidden');
        if (success) success.classList.add('hidden');
        if (errorBox) errorBox.classList.add('hidden');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    };

    window.closeKnowingNotifyModal = function() {
        const modal = document.getElementById('knowing-notify-modal');
        if (!modal) return;
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    };

    const notifyForm = document.getElementById('knowing-notify-form');
    if (notifyForm) {
        notifyForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const submitBtn = document.getElementById('knowing-submit-btn');
            const errorBox = document.getElementById('knowing-form-error');
            const successBox = document.getElementById('knowing-notify-success');

            const name = document.getElementById('knowing-name').value.trim();
            const email = document.getElementById('knowing-email').value.trim();
            const phone = document.getElementById('knowing-phone').value.trim();

            if (!name || !email) return;

            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.textContent = 'Saving...';
            }
            if (errorBox) errorBox.classList.add('hidden');

            try {
                const res = await fetch('/api/pipeline', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        name: name,
                        email: email,
                        phone: phone,
                        stage: 'Interested',
                        notes: 'Knowing God (Isaiah 40:28) - Regional Gathering Priority Waitlist'
                    })
                });

                if (!res.ok) throw new Error('Submission failed');

                notifyForm.classList.add('hidden');
                if (successBox) successBox.classList.remove('hidden');
            } catch (err) {
                if (errorBox) {
                    errorBox.textContent = 'Could not save your request right now. Please try again.';
                    errorBox.classList.remove('hidden');
                }
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Notify Me First →';
                }
            }
        });
    }

    // 3. Calendar .ics Reminder Download for Knowing God
    window.downloadKnowingCalendar = function() {
        const icsContent = [
            'BEGIN:VCALENDAR',
            'VERSION:2.0',
            'PRODID:-//EUCMD Young Adults//Knowing God//EN',
            'BEGIN:VEVENT',
            'SUMMARY:Knowing God (Isaiah 40:28) - EUCMD Young Adults',
            'DESCRIPTION:Do you not know? Have you not heard? The Lord is the everlasting God, the Creator of the ends of the earth (Isaiah 40:28). Stay tuned with EUCMD Young Adults for date and venue announcement.',
            'LOCATION:Silver Spring, MD (Venue Announcing Soon)',
            'DTSTART:20260717T230000Z',
            'DTEND:20260718T020000Z',
            'END:VEVENT',
            'END:VCALENDAR'
        ].join('\r\n');

        const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = 'knowing-god-eucmd-ya.ics';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);
    };

    // 4. YA Moments Lightbox
    const yaPhotos = [
        { src: '/static/ig_images/2026-05-08_01-45-38_UTC_7.jpg', caption: 'Worship Team · Leading in Presence & Praise' },
        { src: '/static/ig_images/2026-05-08_01-45-38_UTC_14.jpg', caption: 'Prayer & Word · Tuesday Night Gathering' },
        { src: '/static/ig_images/2026-05-08_01-45-38_UTC_1.jpg', caption: 'Unhurried Worship · EUCMD Young Adults' },
        { src: '/static/ig_images/2026-05-08_01-45-38_UTC_13.jpg', caption: 'Media & Audio Serving Team' },
        { src: '/static/ig_images/2026-05-08_01-45-38_UTC_17.jpg', caption: 'Keys & Atmosphere · Silver Spring Campus' },
        { src: '/static/ig_images/2026-05-08_01-45-38_UTC_9.jpg', caption: 'Generational Mentorship & Teaching' },
        { src: '/static/ig_images/2026-05-08_01-45-38_UTC_2.jpg', caption: 'Worship Musicians in Unity' },
        { src: '/static/ig_images/2026-05-08_01-45-38_UTC_8.jpg', caption: 'Biblical Teaching & Discipleship' }
    ];
    let currentYaIdx = 0;

    function renderYaLightbox() {
        const img = document.getElementById('ya-lightbox-img');
        const cap = document.getElementById('ya-lightbox-caption');
        const item = yaPhotos[currentYaIdx];
        if (img && item) {
            img.src = item.src;
            img.alt = item.caption;
        }
        if (cap && item) {
            cap.textContent = item.caption + ' (' + (currentYaIdx + 1) + ' / ' + yaPhotos.length + ')';
        }
    }

    window.openYaLightbox = function(idx) {
        currentYaIdx = ((idx % yaPhotos.length) + yaPhotos.length) % yaPhotos.length;
        renderYaLightbox();
        const modal = document.getElementById('ya-lightbox-modal');
        if (modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }
    };

    window.closeYaLightbox = function() {
        const modal = document.getElementById('ya-lightbox-modal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    };

    window.stepYaLightbox = function(delta) {
        currentYaIdx = ((currentYaIdx + delta) % yaPhotos.length + yaPhotos.length) % yaPhotos.length;
        renderYaLightbox();
    };

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            window.closeKnowingNotifyModal && window.closeKnowingNotifyModal();
            window.closeYaLightbox && window.closeYaLightbox();
        }
    });
})();
</script>

