<% if (typeof currentPath === 'undefined' || (!currentPath.startsWith('/dashboard') && !currentPath.startsWith('/login') && !currentPath.startsWith('/member-form'))) { %>
<!-- Sticky Mobile Quick Action Bar (Celestial Azure Glassmorphism) -->
<aside aria-label="Quick Actions" class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-[#060d1d]/90 backdrop-blur-xl border-t border-sky-400/25 px-4 py-2.5 shadow-[0_-8px_25px_rgba(2,6,23,0.85)] flex items-center justify-between gap-3 safe-area-inset-bottom">
    <div class="flex flex-col text-left">
        <span class="text-[10px] font-heading font-bold text-cyan-300 uppercase tracking-wider flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
            Weekly Gatherings
        </span>
        <span class="text-xs font-heading font-semibold text-white">
            Sun 10:30 AM · Fri 7:00 PM
        </span>
    </div>
    <div class="flex items-center gap-2">
        <a href="/events" class="px-3 py-2 rounded-xl bg-white/[0.08] hover:bg-white/15 text-sky-200 hover:text-white text-xs font-heading font-bold uppercase tracking-wider border border-sky-400/25 active:scale-95 transition-all">
            Schedule
        </a>
        <a href="/plan-visit" class="px-3.5 py-2 rounded-xl azure-primary-btn text-white text-xs font-heading font-bold uppercase tracking-wider shadow-lg active:scale-95 transition-all flex items-center gap-1">
            <span>Plan Visit</span>
            <span aria-hidden="true">&rarr;</span>
        </a>
    </div>
</aside>
<% } %>
