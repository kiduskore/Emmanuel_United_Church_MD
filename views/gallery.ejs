let currentPhotoIndex = 0;

function filterGalleryCategory(category, buttonEl) {
    const cards = document.querySelectorAll(".gallery-item-card");
    const buttons = document.querySelectorAll(".gallery-filter-btn");

    buttons.forEach(btn => {
        btn.classList.remove("bg-gradient-to-r", "from-cyan-400", "via-sky-500", "to-blue-600", "text-slate-950", "font-black", "shadow-[0_0_20px_rgba(0,229,255,0.4)]");
        btn.classList.add("bg-white/[0.06]", "border", "border-sky-400/25", "text-sky-200");
    });

    if (buttonEl) {
        buttonEl.classList.remove("bg-white/[0.06]", "border", "border-sky-400/25", "text-sky-200");
        buttonEl.classList.add("bg-gradient-to-r", "from-cyan-400", "via-sky-500", "to-blue-600", "text-slate-950", "font-black", "shadow-[0_0_20px_rgba(0,229,255,0.4)]");
    }

    cards.forEach(card => {
        if (category === "all" || card.getAttribute("data-category") === category) {
            card.style.display = "";
        } else {
            card.style.display = "none";
        }
    });
}

function openPageLightbox(index) {
    if (index < 0 || index >= pageGalleryPhotos.length) return;
    currentPhotoIndex = index;
    const photo = pageGalleryPhotos[index];

    const modal = document.getElementById("page-lightbox-modal");
    const img = document.getElementById("page-lightbox-img");
    const counter = document.getElementById("page-lightbox-counter");
    const badge = document.getElementById("page-lightbox-badge");
    const download = document.getElementById("page-lightbox-download");

    if (modal && img) {
        img.src = photo.src;
        if (counter) counter.textContent = "Photo " + (index + 1) + " of " + pageGalleryPhotos.length;
        if (badge) badge.textContent = photo.badge;
        if (download) download.href = photo.src;
        modal.classList.remove("opacity-0", "pointer-events-none");
        modal.classList.add("opacity-100");
        document.body.style.overflow = "hidden";
    }
}

function closePageLightbox() {
    const modal = document.getElementById("page-lightbox-modal");
    if (modal) {
        modal.classList.add("opacity-0", "pointer-events-none");
        modal.classList.remove("opacity-100");
        document.body.style.overflow = "";
    }
}

function closePageLightboxOnBackdrop(e) {
    if (e.target.id === "page-lightbox-modal") {
        closePageLightbox();
    }
}

function prevPageLightboxPhoto(e) {
    if (e) e.stopPropagation();
    currentPhotoIndex = (currentPhotoIndex - 1 + pageGalleryPhotos.length) % pageGalleryPhotos.length;
    openPageLightbox(currentPhotoIndex);
}

function nextPageLightboxPhoto(e) {
    if (e) e.stopPropagation();
    currentPhotoIndex = (currentPhotoIndex + 1) % pageGalleryPhotos.length;
    openPageLightbox(currentPhotoIndex);
}

document.addEventListener("keydown", (e) => {
    const modal = document.getElementById("page-lightbox-modal");
    if (!modal || modal.classList.contains("pointer-events-none")) return;
    if (e.key === "Escape") closePageLightbox();
    if (e.key === "ArrowLeft") prevPageLightboxPhoto();
    if (e.key === "ArrowRight") nextPageLightboxPhoto();
});
