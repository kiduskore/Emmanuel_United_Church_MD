    <script>
        // Suppress and isolate third-party browser extension errors (e.g. MetaMask, external web3 wallets)
        (function() {
            function isExtError(msg, src, err) {
                var str = (msg || '') + ' ' + (src || '') + ' ' + (err && (err.message || err.stack) || '');
                return /nkbihfbeogaeaoehlefnkodbefgpgknn|chrome-extension:\/\/|moz-extension:\/\/|safari-extension:\/\/|MetaMask|Failed to connect to MetaMask|window\.ethereum/i.test(str);
            }
            window.addEventListener('unhandledrejection', function(event) {
                var reason = event.reason;
                var reasonText = (reason && (reason.message || reason.stack || String(reason))) || '';
                if (isExtError(reasonText, '', reason)) {
                    event.preventDefault();
                    event.stopImmediatePropagation();
                    return false;
                }
            }, true);
            window.addEventListener('error', function(event) {
                if (isExtError(event.message, event.filename, event.error)) {
                    event.preventDefault();
                    event.stopImmediatePropagation();
                    return false;
                }
            }, true);
        })();
    </script>
