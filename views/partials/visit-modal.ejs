<!-- Interactive Plan a Visit Modal (Elevation-Style EUC Maryland) -->
<div id="plan-visit-modal" class="fixed inset-0 z-[150] hidden items-center justify-center p-4 bg-black/85 backdrop-blur-md transition-opacity duration-300 overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="modal-visit-title">
    <div class="relative w-full max-w-xl my-8 bg-zinc-950 text-white rounded-3xl shadow-2xl border border-zinc-800 overflow-hidden transform transition-all">
        
        <!-- Modal Header -->
        <div class="p-6 sm:p-8 bg-zinc-900/90 border-b border-zinc-800 text-white relative">
            <button type="button" onclick="window.closeVisitModal && window.closeVisitModal()" class="absolute top-5 right-5 text-zinc-400 hover:text-white p-2 rounded-full hover:bg-zinc-800 transition-colors focus:outline-none" aria-label="Close modal">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20 text-xs font-heading font-bold uppercase tracking-wider mb-3">
                <span><%= typeof t !== 'undefined' ? t('nav.planVisit') : 'Plan Your Visit' %></span>
            </div>
            <h2 id="modal-visit-title" class="text-2xl sm:text-4xl font-heading font-black uppercase tracking-tight text-white">
                Welcome To EUC Maryland
            </h2>
            <p class="text-xs sm:text-sm text-zinc-300 mt-2 font-sans leading-relaxed">
                We're excited to meet you! Let us know when you're coming so our welcome team can greet your family and help you feel right at home.
            </p>
        </div>

        <!-- Form Body -->
        <div class="p-6 sm:p-8">
            <div id="visit-form-container">
                <form id="plan-visit-form" onsubmit="window.handleVisitSubmit && window.handleVisitSubmit(event); return false;" class="space-y-4">
                    <input type="hidden" name="csrf_token" value="<%= typeof csrf_token !== 'undefined' ? csrf_token : '' %>">
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-heading font-bold uppercase tracking-wider text-zinc-300 mb-1.5" for="visit-name">Full Name *</label>
                            <input type="text" id="visit-name" name="name" required placeholder="e.g. Dawit Bekele" class="w-full px-4 py-3 rounded-xl border border-zinc-800 bg-zinc-900 text-white text-xs sm:text-sm focus:border-amber-400 focus:outline-none transition-all">
                        </div>
                        <div>
                            <label class="block text-xs font-heading font-bold uppercase tracking-wider text-zinc-300 mb-1.5" for="visit-email">Email Address *</label>
                            <input type="email" id="visit-email" name="email" required placeholder="dawit@example.com" class="w-full px-4 py-3 rounded-xl border border-zinc-800 bg-zinc-900 text-white text-xs sm:text-sm focus:border-amber-400 focus:outline-none transition-all">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-heading font-bold uppercase tracking-wider text-zinc-300 mb-1.5" for="visit-phone">Phone Number (Optional)</label>
                            <input type="tel" id="visit-phone" name="phone" placeholder="(240) 716-2246" class="w-full px-4 py-3 rounded-xl border border-zinc-800 bg-zinc-900 text-white text-xs sm:text-sm focus:border-amber-400 focus:outline-none transition-all">
                        </div>
                        <div>
                            <label class="block text-xs font-heading font-bold uppercase tracking-wider text-zinc-300 mb-1.5" for="visit-service">Service to Attend *</label>
                            <select id="visit-service" name="service" required class="w-full px-4 py-3 rounded-xl border border-zinc-800 bg-zinc-900 text-white text-xs sm:text-sm focus:border-amber-400 focus:outline-none transition-all">
                                <option value="sunday_1030">Sunday Worship (10:30 AM · 12604 New Hampshire Ave)</option>
                                <option value="friday_1900">Friday PRAYER and WORSHIP (07:00 PM · 914 Silver Spring Ave)</option>
                                <option value="wednesday_1100">Wednesday Prayer (11:00 AM · 914 Silver Spring Ave)</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-heading font-bold uppercase tracking-wider text-zinc-300 mb-1.5" for="visit-party">Number in Party</label>
                            <select id="visit-party" name="party_size" class="w-full px-4 py-3 rounded-xl border border-zinc-800 bg-zinc-900 text-white text-xs sm:text-sm focus:border-amber-400 focus:outline-none transition-all">
                                <option value="1">Just Me (1)</option>
                                <option value="2">2 People</option>
                                <option value="3">3 People</option>
                                <option value="4+">4 or More (Family / Group)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-heading font-bold uppercase tracking-wider text-zinc-300 mb-1.5" for="visit-kids">Bringing Children? (Ages 4–11)</label>
                            <select id="visit-kids" name="children_info" class="w-full px-4 py-3 rounded-xl border border-zinc-800 bg-zinc-900 text-white text-xs sm:text-sm focus:border-amber-400 focus:outline-none transition-all">
                                <option value="no">No children</option>
                                <option value="yes_kids_church">Yes, will join Kingdom Kids</option>
                                <option value="yes_with_us">Yes, will sit with us in Sanctuary</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-heading font-bold uppercase tracking-wider text-zinc-300 mb-1.5" for="visit-notes">Questions or Prayer Needs</label>
                        <textarea id="visit-notes" name="notes" rows="2" placeholder="Let us know if you need parking guidance, language translation, or have any questions..." class="w-full px-4 py-2.5 rounded-xl border border-zinc-800 bg-zinc-900 text-white text-xs sm:text-sm focus:border-amber-400 focus:outline-none transition-all"></textarea>
                    </div>

                    <div id="visit-form-error" class="hidden p-3 rounded-xl bg-red-500/20 border border-red-500/30 text-red-300 text-xs font-medium"></div>

                    <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-3">
                        <button type="submit" id="visit-submit-btn" class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 active:bg-amber-600 text-zinc-950 font-heading font-bold text-xs uppercase tracking-wider shadow-md transition-all active:scale-95 flex items-center justify-center gap-2">
                            <span>Register My Visit</span>
                            <span aria-hidden="true">&rarr;</span>
                        </button>
                        <button type="button" onclick="window.downloadServiceIcs && window.downloadServiceIcs()" class="w-full sm:w-auto px-4 py-3 rounded-xl border border-zinc-700 text-zinc-300 hover:text-white hover:bg-zinc-800 font-heading text-xs font-bold uppercase tracking-wider transition-all flex items-center justify-center gap-1.5">
                            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            <span>Add to Calendar (.ics)</span>
                        </button>
                    </div>
                </form>
            </div>

            <!-- Confirmation View -->
            <div id="visit-success-view" class="hidden space-y-5 text-center py-4">
                <div class="w-16 h-16 rounded-2xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center mx-auto text-3xl font-bold">
                    ✓
                </div>
                <div>
                    <h3 class="text-2xl font-heading font-bold uppercase text-white">We Look Forward To Meeting You!</h3>
                    <p class="text-xs sm:text-sm text-zinc-400 mt-1 max-w-md mx-auto font-sans leading-relaxed" id="visit-confirmed-msg">
                        Your visit has been registered with our pastoral care and hospitality team.
                    </p>
                </div>

                <!-- Helpful Tips Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-left pt-2 font-sans">
                    <div class="p-3.5 rounded-2xl bg-zinc-900 border border-zinc-800">
                        <div class="text-xs font-bold text-white mb-1">🚗 Free Parking</div>
                        <p class="text-[11px] text-zinc-400 leading-tight">Ample on-site parking directly adjacent to the main building entrance.</p>
                    </div>
                    <div class="p-3.5 rounded-2xl bg-zinc-900 border border-zinc-800">
                        <div class="text-xs font-bold text-white mb-1">👋 Warm Greeters</div>
                        <p class="text-[11px] text-zinc-400 leading-tight">Look for our welcoming team at the foyer ready to assist your family.</p>
                    </div>
                    <div class="p-3.5 rounded-2xl bg-zinc-900 border border-zinc-800">
                        <div class="text-xs font-bold text-white mb-1">👶 Kingdom Kids</div>
                        <p class="text-[11px] text-zinc-400 leading-tight">Children check-in opens at 10:15 AM for a fun, Bible-centered lesson.</p>
                    </div>
                </div>

                <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
                    <button type="button" onclick="window.downloadServiceIcs && window.downloadServiceIcs()" class="w-full sm:w-auto px-5 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-zinc-950 font-heading font-bold text-xs uppercase tracking-wider shadow-md transition-all">
                        Download Calendar Reminder (.ics)
                    </button>
                    <a href="https://maps.google.com/?q=12604+New+Hampshire+Ave,+Silver+Spring,+MD+20904" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto px-4 py-3 rounded-xl border border-zinc-700 text-zinc-300 hover:text-white font-heading text-xs font-bold uppercase tracking-wider transition-all">
                        Open in Google Maps &rarr;
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
window.openVisitModal = function() {
    const modal = document.getElementById('plan-visit-modal');
    if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }
};

window.closeVisitModal = function() {
    const modal = document.getElementById('plan-visit-modal');
    if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
    }
};

window.downloadServiceIcs = function() {
    const serviceSelect = document.getElementById('visit-service');
    const isSunday = !serviceSelect || serviceSelect.value === 'sunday_1030';
    const isFriday = serviceSelect && serviceSelect.value === 'friday_1900';
    
    const title = isSunday 
        ? 'EUC Maryland Sunday Worship Service' 
        : (isFriday ? 'EUC Friday PRAYER and WORSHIP' : 'EUC Maryland Midweek Prayer Gathering');
    const location = isSunday 
        ? '12604 New Hampshire Ave, Silver Spring, MD 20904' 
        : 'Suite 204B, 914 Silver Spring Ave, Silver Spring, MD 20910';
    const description = isSunday
        ? 'Sunday corporate worship, choir & praise, communal prayer, and expository biblical preaching at Emmanuel United Church of Maryland.'
        : (isFriday
            ? 'Friday night intercessory prayer, praise, and worship at Emmanuel United Church of Maryland.'
            : 'Midweek intercessory prayer, spiritual renewal, and fellowship at Emmanuel United Church of Maryland.');

    const now = new Date();
    // Calculate next Sunday, Friday, or Wednesday
    let targetDay = isSunday ? 0 : (isFriday ? 5 : 3); // 0 = Sunday, 5 = Friday, 3 = Wednesday
    let daysUntil = (targetDay + 7 - now.getDay()) % 7;
    if (daysUntil === 0) daysUntil = 7;
    
    const eventDate = new Date(now.getTime() + daysUntil * 24 * 60 * 60 * 1000);
    if (isSunday) {
        eventDate.setHours(10, 30, 0, 0);
    } else if (isFriday) {
        eventDate.setHours(19, 0, 0, 0);
    } else {
        eventDate.setHours(11, 0, 0, 0);
    }
    const endDate = new Date(eventDate.getTime() + (isSunday ? 3.5 : (isFriday ? 2.5 : 3)) * 60 * 60 * 1000);

    const pad = (n) => String(n).padStart(2, '0');
    const formatIcsDate = (d) => {
        return d.getUTCFullYear() +
            pad(d.getUTCMonth() + 1) +
            pad(d.getUTCDate()) + 'T' +
            pad(d.getUTCHours()) +
            pad(d.getUTCMinutes()) + '00Z';
    };

    const icsContent = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//Emmanuel United Church of Maryland//NONSGML Visit//EN',
        'CALSCALE:GREGORIAN',
        'METHOD:PUBLISH',
        'BEGIN:VEVENT',
        `UID:${Date.now()}@eucmaryland.org`,
        `DTSTAMP:${formatIcsDate(new Date())}`,
        `DTSTART:${formatIcsDate(eventDate)}`,
        `DTEND:${formatIcsDate(endDate)}`,
        `SUMMARY:${title}`,
        `LOCATION:${location}`,
        `DESCRIPTION:${description}`,
        'STATUS:CONFIRMED',
        'END:VEVENT',
        'END:VCALENDAR'
    ].join('\r\n');

    const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
    const link = document.createElement('a');
    link.href = window.URL.createObjectURL(blob);
    link.setAttribute('download', isSunday ? 'EUC_Sunday_Service.ics' : 'EUC_Midweek_Prayer.ics');
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
};

window.handleVisitSubmit = async function(e) {
    if (e && e.preventDefault) e.preventDefault();
    const form = document.getElementById('plan-visit-form');
    const submitBtn = document.getElementById('visit-submit-btn');
    const errorBox = document.getElementById('visit-form-error');
    const formContainer = document.getElementById('visit-form-container');
    const successView = document.getElementById('visit-success-view');
    const confirmedMsg = document.getElementById('visit-confirmed-msg');

    if (!form) return;
    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());

    if (errorBox) errorBox.classList.add('hidden');
    if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>Saving...</span>';
    }

    try {
        const res = await fetch('/api/plan-visit', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'x-csrf-token': payload.csrf_token || ''
            },
            body: JSON.stringify(payload)
        });

        if (res.ok) {
            if (formContainer) formContainer.classList.add('hidden');
            if (successView) successView.classList.remove('hidden');
            if (confirmedMsg) {
                const serviceLabel = payload.service === 'sunday_1030' 
                    ? 'Sunday at 10:30 AM' 
                    : (payload.service === 'friday_1900' ? 'Friday at 07:00 PM' : 'Wednesday at 11:00 AM');
                confirmedMsg.textContent = `Thank you, ${payload.name}! We've saved your spot for ${serviceLabel}. A confirmation has been sent to ${payload.email}.`;
            }
        } else {
            const errData = await res.json().catch(() => ({}));
            if (errorBox) {
                errorBox.textContent = errData.error || 'Failed to submit visit request. Please try again.';
                errorBox.classList.remove('hidden');
            }
        }
    } catch (err) {
        if (errorBox) {
            errorBox.textContent = 'Network error. Please try again or call us at (240) 716-2246.';
            errorBox.classList.remove('hidden');
        }
    } finally {
        if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Register My Visit</span> &rarr;';
        }
    }
};
</script>
