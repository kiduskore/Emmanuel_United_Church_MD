    <style>
        :root {
            --font-main: 'Plus Jakarta Sans', 'Noto Sans Ethiopic', system-ui, -apple-system, sans-serif;
        }

        html {
            -webkit-text-size-adjust: 100%;
            touch-action: manipulation;
            scroll-behavior: smooth;
        }

        /* Ensure in-page anchor links clear the sticky 5rem (h-20) navigation header */
        [id], section[id] {
            scroll-margin-top: 6rem;
        }

        /* Mobile touch & iOS optimizations */
        *, *::before, *::after {
            -webkit-tap-highlight-color: transparent;
        }

        button, a, input, select, textarea {
            touch-action: manipulation;
        }

        /* Prevent iOS Safari from auto-zooming on focus while keeping desktop typography crisp */
        @media screen and (max-width: 768px) {
            input, select, textarea {
                font-size: 16px !important;
            }
        }

        /* Safe area insets for iOS devices (iPhone with notch/dynamic island & home indicator) */
        .ios-safe-top {
            padding-top: max(1.25rem, env(safe-area-inset-top));
        }

        .ios-safe-bottom {
            padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
        }

        /* Touch device active states (replaces mouse-dependent hover) */
        @media (hover: none) and (pointer: coarse) {
            .macos-glass:active,
            .macos-card:active {
                transform: scale(0.99);
                transition: transform 0.15s ease;
            }
            .macos-glass:hover {
                transform: none;
            }
            button:active,
            a:active {
                opacity: 0.85;
            }
        }

        body {
            font-family: var(--font-main);
            margin: 0;
            min-height: 100vh;
            min-height: -webkit-fill-available;
            transition: background-color 0.4s cubic-bezier(0.19, 1, 0.22, 1), color 0.4s cubic-bezier(0.19, 1, 0.22, 1);
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            -webkit-overflow-scrolling: touch;
        }

        /* Ethiopic Script Optimization for Amharic and Tigrinya */
        html[lang="am"] body,
        html[lang="ti"] body,
        .font-ethiopic {
            font-family: 'Noto Sans Ethiopic', 'Plus Jakarta Sans', system-ui, sans-serif;
            letter-spacing: normal;
        }
        
        /* Layout Utilities */
        .masonry-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
            grid-auto-flow: dense;
        }
        
        .masonry-item-large {
            grid-column: span 2;
            grid-row: span 2;
        }

        @media (max-width: 768px) {
            .masonry-item-large {
                grid-column: span 1;
                grid-row: span 1;
            }
        }

        /* Progressive Enhancement: Elements are ALWAYS visible by default to guarantee instant iPhone loading */
        .gsap-reveal, .gsap-fade-up, .gsap-stagger-item, .gsap-scale-up {
            visibility: visible;
            opacity: 1;
        }
        
        /* ======================================================== */
        /* CELESTIAL AZURE GLASSMORPHISM (IMAGE_29354439.PNG THEME) */
        /* Deep space midnight navy, cyan spotlight, frosted glass  */
        /* ======================================================== */
        body {
            background-color: #060d1d !important;
            color: #f8fafc !important;
            background-image: 
                radial-gradient(ellipse 80% 55% at 50% -10%, rgba(14, 165, 233, 0.45) 0%, rgba(2, 132, 199, 0.25) 35%, rgba(6, 13, 29, 0) 75%),
                radial-gradient(ellipse 50% 40% at 85% 20%, rgba(6, 182, 212, 0.16) 0%, transparent 60%),
                radial-gradient(circle at 15% 85%, rgba(14, 116, 144, 0.18) 0%, transparent 55%),
                radial-gradient(circle at 50% 60%, rgba(30, 58, 138, 0.15) 0%, transparent 60%);
            background-attachment: fixed;
        }

        /* Outer Azure Frosted Glass Container (Matching attachment outer card) */
        .azure-glass-shell,
        .nft-glass-card {
            background: linear-gradient(180deg, rgba(20, 115, 230, 0.28) 0%, rgba(10, 55, 125, 0.18) 35%, rgba(8, 20, 42, 0.82) 100%);
            backdrop-filter: blur(36px) saturate(190%);
            -webkit-backdrop-filter: blur(36px) saturate(190%);
            border: 1px solid rgba(125, 211, 252, 0.35);
            border-top: 1.5px solid rgba(255, 255, 255, 0.75);
            border-radius: 2.5rem;
            box-shadow: 
                0 25px 60px -15px rgba(2, 6, 23, 0.85),
                0 0 45px -10px rgba(14, 165, 233, 0.35),
                inset 0 1.5px 1px 0 rgba(255, 255, 255, 0.6),
                inset 0 -1px 1px 0 rgba(56, 189, 248, 0.2);
            transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
            position: relative;
        }

        .azure-glass-shell:hover,
        .nft-glass-card:hover {
            border-color: rgba(56, 189, 248, 0.55);
            transform: translateY(-2px);
            box-shadow: 
                0 30px 70px -15px rgba(2, 6, 23, 0.9),
                0 0 55px -5px rgba(14, 165, 233, 0.45),
                inset 0 2px 1.5px 0 rgba(255, 255, 255, 0.75);
        }

        /* Inner Nested Dark Glass Card (Matching attachment inner tasks) */
        .azure-inner-card {
            background: rgba(10, 18, 34, 0.82);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-top: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 1.5rem;
            box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.15);
            transition: all 0.25s ease;
        }

        .azure-inner-card:hover {
            background: rgba(14, 25, 46, 0.9);
            border-color: rgba(56, 189, 248, 0.35);
        }

        /* Diamond Star Lens Flare Sparkle (Attachment glint feature) */
        .diamond-glint {
            position: absolute;
            width: 24px;
            height: 24px;
            pointer-events: none;
            z-index: 30;
        }
        .diamond-glint::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 22px;
            height: 2.5px;
            background: #ffffff;
            box-shadow: 0 0 10px 2px #38bdf8, 0 0 20px 4px #00e5ff;
            border-radius: 9999px;
        }
        .diamond-glint::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 2.5px;
            height: 22px;
            background: #ffffff;
            box-shadow: 0 0 10px 2px #38bdf8, 0 0 20px 4px #00e5ff;
            border-radius: 9999px;
        }

        /* Glowing Electric Cyan Progress Bar (Attachment signature widget) */
        .cyan-progress-track {
            height: 7px;
            border-radius: 9999px;
            background: rgba(255, 255, 255, 0.12);
            overflow: hidden;
            position: relative;
        }

        .cyan-progress-fill {
            height: 100%;
            border-radius: 9999px;
            background: linear-gradient(90deg, #38bdf8 0%, #00e5ff 100%);
            box-shadow: 0 0 14px rgba(0, 229, 255, 0.9);
        }

        /* Frosted Pill Buttons & Badges (Matching "In progress" badge) */
        .nft-frosted-pill,
        .azure-pill {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 9999px;
            color: #ffffff;
            transition: all 0.25s ease;
        }

        .nft-frosted-pill:hover,
        .azure-pill:hover {
            background: rgba(255, 255, 255, 0.16);
            border-color: rgba(56, 189, 248, 0.5);
            box-shadow: 0 0 20px rgba(56, 189, 248, 0.35);
        }

        /* Primary Glowing Azure/Cyan Pill Button */
        .nft-primary-btn,
        .azure-primary-btn {
            background: linear-gradient(135deg, #0284c7 0%, #0ea5e9 50%, #00d2ff 100%);
            border: 1px solid rgba(255, 255, 255, 0.45);
            color: #ffffff;
            box-shadow: 0 10px 30px -5px rgba(14, 165, 233, 0.6), inset 0 1.5px 0 rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(14px);
            border-radius: 9999px;
            transition: all 0.25s ease;
        }

        .nft-primary-btn:hover,
        .azure-primary-btn:hover {
            background: linear-gradient(135deg, #0369a1 0%, #0284c7 50%, #38bdf8 100%);
            box-shadow: 0 15px 40px -5px rgba(0, 229, 255, 0.7), inset 0 2px 0 rgba(255, 255, 255, 0.8);
            transform: translateY(-2px) scale(1.01);
        }

        .nft-glow-text,
        .azure-glow-text {
            text-shadow: 0 2px 20px rgba(56, 189, 248, 0.55);
        }

        .nft-gradient-text,
        .azure-gradient-text {
            background: linear-gradient(135deg, #ffffff 40%, #7dd3fc 75%, #38bdf8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Floating Bottom Glass Dock */
        .nft-dock {
            background: rgba(8, 18, 38, 0.85);
            backdrop-filter: blur(32px) saturate(200%);
            -webkit-backdrop-filter: blur(32px) saturate(200%);
            border: 1px solid rgba(56, 189, 248, 0.35);
            border-top: 1.5px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7), 0 0 30px rgba(14, 165, 233, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.3);
            border-radius: 9999px;
        }

        .nft-hex-btn {
            background: linear-gradient(135deg, #0284c7, #00d2ff);
            clip-path: polygon(50% 0%, 95% 25%, 95% 75%, 50% 100%, 5% 75%, 5% 25%);
            box-shadow: 0 0 25px rgba(0, 210, 255, 0.8);
        }
        
        .editorial-rule {
            height: 1px;
            background-color: #E8E1D5;
        }
        html.dark .editorial-rule {
            background-color: #2E2820;
        }
        
        /* Reading Progress Bar */
        #progress-bar {
            position: fixed;
            top: 0;
            left: 0;
            height: 3px;
            background: linear-gradient(to right, #9E6738, #B65C2B);
            width: 0%;
            z-index: 9999;
            transition: width 0.1s ease;
        }
    </style>
</head>
