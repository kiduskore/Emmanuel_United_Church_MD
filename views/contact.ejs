<%- include('partials/header', { 
    metaTitle: 'Contact Us & Locations | Emmanuel United Church of Maryland',
    metaDesc: 'Get in touch with Emmanuel United Church of Maryland, find directions to our Silver Spring worship sanctuary and administrative offices, or send a prayer request.',
    currentPath: '/contact'
}) %>

<%- include('partials/navbar') %>

<main id="main-content" class="min-h-screen text-white selection:bg-cyan-500 selection:text-slate-950 pt-24 pb-20 relative overflow-hidden">

    <!-- Ambient Celestial Azure Aurora Spotlight Flares -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
        <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[900px] h-[600px] bg-sky-500/18 rounded-full filter blur-[150px]"></div>
        <div class="absolute top-1/3 -right-40 w-[600px] h-[600px] bg-cyan-400/14 rounded-full filter blur-[160px]"></div>
        <div class="absolute bottom-10 left-1/4 w-[550px] h-[550px] bg-blue-700/16 rounded-full filter blur-[150px]"></div>
    </div>

    <!-- Celestial Azure Glassmorphic Contact Hero Header -->
    <section class="py-16 sm:py-24 text-center relative overflow-hidden z-10">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="inline-flex items-center gap-2 px-5 py-2 rounded-full bg-white/[0.08] border border-sky-400/30 text-xs font-heading font-bold uppercase tracking-widest text-cyan-300 mb-6 backdrop-blur-xl shadow-lg">
                <span class="font-ethiopic font-bold text-amber-300">አድራሻ</span>
                <span aria-hidden="true" class="text-white/40">·</span>
                <span class="text-white">Locations & Contact</span>
            </div>
            <h1 class="text-4xl sm:text-6xl md:text-7xl font-heading font-black tracking-tight uppercase text-white mb-6">
                Locations & Contact
            </h1>
            <p class="text-base sm:text-xl text-sky-100/90 max-w-2xl mx-auto font-sans leading-relaxed text-balance">
                Whether you're planning a visit this Sunday, seeking pastoral counsel, or looking to connect with our church family, we're here for you.
            </p>
        </div>
    </section>

    <div class="py-12 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
            
            <!-- Left: Contact Details & Campus Locations (5 cols) -->
            <div class="lg:col-span-5 space-y-6">
                
                <!-- Main Worship Campus -->
                <div class="p-8 rounded-[2.2rem] azure-glass-shell border border-sky-400/30 shadow-2xl space-y-4 relative overflow-hidden">
                    <div class="diamond-glint top-6 right-6 hidden sm:block"></div>
                    <span class="px-3.5 py-1 rounded-full bg-sky-500/20 text-cyan-300 border border-sky-400/30 text-xs font-heading font-bold uppercase tracking-wider">
                        Main Worship Campus
                    </span>
                    <h3 class="text-2xl font-heading font-bold uppercase text-white">Sunday Worship Sanctuary</h3>
                    <p class="text-xs sm:text-sm text-sky-100/80 font-sans leading-relaxed">
                        Join our church family every Sunday morning for passionate praise, choir, communal prayer, and expository preaching.
                    </p>
                    <div class="pt-2 text-xs font-sans text-sky-200/90 space-y-1.5 p-4 rounded-xl azure-inner-card border border-sky-400/20">
                        <div><strong class="text-white font-heading uppercase text-xs">Address:</strong> 12604 New Hampshire Ave, Silver Spring, MD 20904</div>
                        <div><strong class="text-white font-heading uppercase text-xs">Service Time:</strong> Sundays, 10:30 AM – 2:00 PM EST</div>
                        <div><strong class="text-white font-heading uppercase text-xs">Parking:</strong> Large free on-site lot directly in front of the sanctuary entrance.</div>
                    </div>
                    <div class="pt-3">
                        <a href="https://maps.google.com/?q=12604+New+Hampshire+Ave,+Silver+Spring,+MD+20904" target="_blank" rel="noopener noreferrer" class="text-xs font-heading font-bold uppercase tracking-wider text-cyan-300 hover:text-white transition-colors inline-flex items-center gap-1.5">
                            <span>Open in Google Maps</span>
                            <span aria-hidden="true">&rarr;</span>
                        </a>
                    </div>
                </div>

                <!-- Midweek & Administrative Location -->
                <div class="p-8 rounded-[2.2rem] azure-glass-shell border border-sky-400/30 shadow-2xl space-y-4 relative overflow-hidden">
                    <span class="px-3.5 py-1 rounded-full bg-sky-950/70 text-sky-200 border border-sky-400/30 text-xs font-heading font-bold uppercase tracking-wider">
                        Prayer & Office Center
                    </span>
                    <h3 class="text-2xl font-heading font-bold uppercase text-white">Midweek Gathering & Administration</h3>
                    <p class="text-xs sm:text-sm text-sky-100/80 font-sans leading-relaxed">
                        Midweek intercessory prayer, fasting, and administrative office of Senior Pastor Dr. Bezalem Fisseha.
                    </p>
                    <div class="pt-2 text-xs font-sans text-sky-200/90 space-y-1.5 p-4 rounded-xl azure-inner-card border border-sky-400/20">
                        <div><strong class="text-white font-heading uppercase text-xs">Address:</strong> 914 Silver Spring Ave, Ste 204B, Silver Spring, MD 20910</div>
                        <div><strong class="text-white font-heading uppercase text-xs">Prayer Schedule:</strong> Wednesdays, 11:00 AM – 2:00 PM EST</div>
                        <div><strong class="text-white font-heading uppercase text-xs">Office Hours:</strong> Monday – Friday, 9:00 AM – 3:00 PM EST</div>
                    </div>
                    <div class="pt-3">
                        <a href="https://maps.google.com/?q=914+Silver+Spring+Ave,+Silver+Spring,+MD+20910" target="_blank" rel="noopener noreferrer" class="text-xs font-heading font-bold uppercase tracking-wider text-cyan-300 hover:text-white transition-colors inline-flex items-center gap-1.5">
                            <span>Open in Google Maps</span>
                            <span aria-hidden="true">&rarr;</span>
                        </a>
                    </div>
                </div>

                <!-- Pastoral Contacts & Hours -->
                <div class="p-8 rounded-[2.2rem] azure-glass-shell border border-sky-400/30 shadow-2xl space-y-4 text-xs font-sans">
                    <div class="flex items-center gap-4">
                        <img src="/static/pastor_dr_bezalem_fisseha.png" alt="Pastor Dr. Bezalem Fisseha" class="w-16 h-16 rounded-2xl object-cover object-top border border-sky-400/40 shadow-lg shrink-0">
                        <div>
                            <span class="text-[10px] font-heading font-bold uppercase tracking-widest text-cyan-300">Pastoral Care</span>
                            <h4 class="font-heading font-bold uppercase text-base text-white">Pastor Dr. Bezalem Fisseha</h4>
                            <p class="text-[11px] text-sky-300/80">Senior Pastor · Founder</p>
                        </div>
                    </div>
                    <div class="space-y-2 text-sky-200/90 pt-3 border-t border-sky-400/20">
                        <div><strong class="text-white font-heading uppercase text-xs">Pastor Email:</strong> <a href="mailto:bezalemf@yahoo.com" class="text-cyan-300 hover:underline">bezalemf@yahoo.com</a></div>
                        <div><strong class="text-white font-heading uppercase text-xs">General Church Email:</strong> <a href="mailto:emmanuelchurch.maryland@gmail.com" class="text-cyan-300 hover:underline">emmanuelchurch.maryland@gmail.com</a></div>
                        <div><strong class="text-white font-heading uppercase text-xs">Office Phone:</strong> <a href="tel:2407162246" class="text-white hover:text-cyan-300 font-bold">(240) 716-2246</a></div>
                    </div>
                </div>

            </div>

            <!-- Right: Interactive Contact Form & Map (7 cols) -->
            <div class="lg:col-span-7 space-y-8">
                
                <!-- Google Maps Interactive Embed -->
                <div class="rounded-[2.2rem] overflow-hidden border border-sky-400/30 shadow-2xl azure-glass-shell">
                    <div class="p-4 bg-sky-950/60 border-b border-sky-400/20 flex items-center justify-between">
                        <span class="text-xs font-heading font-bold uppercase tracking-wider text-white">Main Worship Sanctuary Map</span>
                        <span class="text-xs text-cyan-300 font-sans font-semibold">12604 New Hampshire Ave</span>
                    </div>
                    <div class="aspect-video w-full bg-[#060d1d]">
                        <iframe 
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3096.388432320495!2d-76.99436322353846!3d39.06346747168994!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89b7cf349890ad6b%3A0xc3f58eeb0c968940!2s12604%20New%20Hampshire%20Ave%2C%20Silver%20Spring%2C%20MD%2020904!5e0!3m2!1sen!2sus!4v1711200000000!5m2!1sen!2sus" 
                            width="100%" 
                            height="100%" 
                            style="border:0;" 
                            allowfullscreen="" 
                            loading="lazy" 
                            referrerpolicy="no-referrer-when-downgrade"
                            title="Emmanuel United Church Worship Sanctuary Map"
                            class="filter invert-[0.9] hue-rotate-[180deg] contrast-[0.9]">
                        </iframe>
                    </div>
                </div>

                <!-- Contact / Inquiry Form -->
                <div class="p-8 sm:p-10 rounded-[2.5rem] azure-glass-shell border border-sky-400/30 shadow-2xl relative overflow-hidden">
                    <div class="diamond-glint top-6 right-6 hidden sm:block"></div>
                    <div class="mb-6">
                        <span class="text-xs font-heading font-bold uppercase tracking-widest text-cyan-300">
                            We'd Love To Hear From You
                        </span>
                        <h3 class="text-2xl sm:text-3xl font-heading font-bold uppercase text-white mt-1">
                            Send A Message
                        </h3>
                        <p class="text-xs sm:text-sm text-sky-200/80 font-sans mt-1">
                            Inquiries are reviewed directly by our pastoral care team.
                        </p>
                    </div>

                    <form id="contact-inquiry-form" onsubmit="window.handleContactSubmit(event); return false;" class="space-y-4">
                        <input type="hidden" name="csrf_token" value="<%= typeof csrf_token !== 'undefined' ? csrf_token : '' %>">

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-heading font-bold uppercase tracking-wider text-sky-200 mb-1.5" for="contact-name">Full Name *</label>
                                <input type="text" id="contact-name" name="name" required placeholder="Your full name" class="w-full px-4 py-3 rounded-xl border border-sky-400/25 bg-[#060d1d]/80 text-white placeholder-sky-300/40 text-xs sm:text-sm focus:border-cyan-400 focus:outline-none transition-all">
                            </div>
                            <div>
                                <label class="block text-xs font-heading font-bold uppercase tracking-wider text-sky-200 mb-1.5" for="contact-email">Email Address *</label>
                                <input type="email" id="contact-email" name="email" required placeholder="you@example.com" class="w-full px-4 py-3 rounded-xl border border-sky-400/25 bg-[#060d1d]/80 text-white placeholder-sky-300/40 text-xs sm:text-sm focus:border-cyan-400 focus:outline-none transition-all">
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-heading font-bold uppercase tracking-wider text-sky-200 mb-1.5" for="contact-phone">Phone Number (Optional)</label>
                                <input type="tel" id="contact-phone" name="phone" placeholder="(240) 716-2246" class="w-full px-4 py-3 rounded-xl border border-sky-400/25 bg-[#060d1d]/80 text-white placeholder-sky-300/40 text-xs sm:text-sm focus:border-cyan-400 focus:outline-none transition-all">
                            </div>
                            <div>
                                <label class="block text-xs font-heading font-bold uppercase tracking-wider text-sky-200 mb-1.5" for="contact-type">Inquiry Subject *</label>
                                <select id="contact-type" name="inquiry_type" required class="w-full px-4 py-3 rounded-xl border border-sky-400/25 bg-[#060d1d]/80 text-white text-xs sm:text-sm focus:border-cyan-400 focus:outline-none transition-all">
                                    <option value="general">General Inquiry</option>
                                    <option value="plan_visit">Planning My First Visit</option>
                                    <option value="pastoral_counseling">Pastoral Counseling with Dr. Bezalem</option>
                                    <option value="prayer">Prayer Request</option>
                                    <option value="ministry_join">Joining a Ministry / Life Group</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-heading font-bold uppercase tracking-wider text-sky-200 mb-1.5" for="contact-message">Your Message *</label>
                            <textarea id="contact-message" name="message" rows="4" required placeholder="How can our pastoral team assist you?" class="w-full px-4 py-3 rounded-xl border border-sky-400/25 bg-[#060d1d]/80 text-white placeholder-sky-300/40 text-xs sm:text-sm focus:border-cyan-400 focus:outline-none transition-all"></textarea>
                        </div>

                        <div id="contact-error" class="hidden p-3 rounded-xl bg-red-500/20 border border-red-500/30 text-red-300 text-xs font-medium"></div>
                        <div id="contact-success" class="hidden p-4 rounded-xl bg-emerald-500/20 border border-emerald-500/30 text-emerald-300 text-xs font-medium">
                            ✓ Thank you! Your message has been sent to our pastoral team. We will get back to you promptly.
                        </div>

                        <button type="submit" id="contact-submit-btn" class="w-full py-4 rounded-full azure-primary-btn text-white font-heading font-bold text-xs uppercase tracking-wider shadow-lg transition-all active:scale-95">
                            Send Message &rarr;
                        </button>
                    </form>
                </div>

            </div>

        </div>

    </div>

</main>

<script>
window.handleContactSubmit = async function(e) {
    if (e && e.preventDefault) e.preventDefault();
    const form = document.getElementById('contact-inquiry-form');
    const submitBtn = document.getElementById('contact-submit-btn');
    const errorBox = document.getElementById('contact-error');
    const successBox = document.getElementById('contact-success');

    if (!form) return;
    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());

    errorBox.classList.add('hidden');
    successBox.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending Message...';

    try {
        const res = await fetch('/api/contact', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'x-csrf-token': payload.csrf_token || ''
            },
            body: JSON.stringify(payload)
        });

        if (res.ok) {
            successBox.classList.remove('hidden');
            form.reset();
        } else {
            const errData = await res.json().catch(() => ({}));
            errorBox.textContent = errData.error || 'Failed to send message. Please try again or call (240) 716-2246.';
            errorBox.classList.remove('hidden');
        }
    } catch (err) {
        errorBox.textContent = 'Network error. Please try again or call our office at (240) 716-2246.';
        errorBox.classList.remove('hidden');
    } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Message \u2192';
    }
};
</script>

<%- include('partials/footer') %>
