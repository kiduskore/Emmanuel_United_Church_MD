<!-- Elevation-Style "Watch Online / Live Stream" Modal -->
<div id="watch-online-modal" class="fixed inset-0 z-[160] hidden items-center justify-center p-2 sm:p-4 md:p-6 bg-black/90 backdrop-blur-md transition-opacity duration-300" role="dialog" aria-modal="true" aria-labelledby="modal-watch-title">
    <div class="relative w-full max-w-5xl bg-zinc-950 text-white rounded-2xl md:rounded-3xl shadow-2xl border border-zinc-800 overflow-hidden flex flex-col max-h-[92vh]">
        
        <!-- Top Bar -->
        <div class="flex items-center justify-between px-5 py-4 border-b border-zinc-800/80 bg-zinc-900/60">
            <div class="flex items-center gap-3">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-red-600/20 text-red-400 border border-red-500/30 text-[11px] font-bold uppercase tracking-wider">
                    <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                    EUC Online
                </span>
                <h3 id="modal-watch-title" class="text-sm sm:text-base font-heading font-bold uppercase tracking-wide text-zinc-100 truncate">
                    Sunday Worship Broadcast · Silver Spring, MD
                </h3>
            </div>
            <button type="button" onclick="window.closeWatchModal && window.closeWatchModal()" class="p-2 text-zinc-400 hover:text-white hover:bg-zinc-800 rounded-full transition-colors focus:outline-none" aria-label="Close broadcast modal">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        <!-- Video & Interaction Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 flex-1 overflow-y-auto lg:overflow-hidden">
            
            <!-- Main Video Column (8 cols) -->
            <div class="lg:col-span-8 bg-black flex flex-col justify-between">
                <!-- Video Container -->
                <div class="relative aspect-video w-full bg-zinc-900 overflow-hidden group">
                    <iframe 
                        id="watch-video-iframe"
                        class="w-full h-full"
                        src="https://www.youtube.com/embed/-PYZ0R0Nelc?enablejsapi=1&rel=0&modestbranding=1" 
                        data-src="https://www.youtube.com/embed/-PYZ0R0Nelc?autoplay=1&enablejsapi=1&rel=0&modestbranding=1"
                        title="Emmanuel United Church of Maryland Worship Broadcast" 
                        frameborder="0" 
                        referrerpolicy="strict-origin-when-cross-origin"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                        allowfullscreen>
                    </iframe>
                </div>

                <!-- Video Meta & Service Details -->
                <div class="p-4 sm:p-6 bg-zinc-950 border-t border-zinc-800/80">
                    <div class="flex flex-wrap items-center justify-between gap-3 mb-2">
                        <span class="text-xs font-semibold text-amber-400 uppercase tracking-wider">
                            Latest Message · Pastor Dr. Bezalem Fisseha
                        </span>
                        <div class="flex items-center gap-2 text-xs text-zinc-400">
                            <span>Sundays 10:30 AM EST</span>
                            <span>·</span>
                            <span>Replay Available 24/7</span>
                        </div>
                    </div>
                    <h2 class="text-xl sm:text-2xl font-heading font-bold tracking-tight text-white mb-2">
                        Wholistic Development for Wholistic Mission
                    </h2>
                    <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed max-w-2xl">
                        "ሁለንተናዊ ዕድገት ለሁለንተናዊ ተልዕኮ" — Discover how God transforms every dimension of our life (spirit, mind, family, and vocation) to empower us for His kingdom assignment in Maryland and beyond.
                    </p>

                    <!-- Quick Action Chips -->
                    <div class="flex flex-wrap items-center gap-3 mt-4 pt-4 border-t border-zinc-900">
                        <button type="button" onclick="window.openVisitModal && (window.closeWatchModal(), window.openVisitModal())" class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-zinc-950 font-bold text-xs uppercase tracking-wider transition-all">
                            Plan an In-Person Visit
                        </button>
                        <a href="/give" class="px-4 py-2 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-white font-semibold text-xs transition-colors">
                            Give Online (Zelle)
                        </a>
                        <a href="/about#leadership" class="px-3.5 py-2 rounded-xl border border-zinc-700 text-zinc-300 hover:text-white text-xs transition-colors">
                            About Dr. Bezalem &rarr;
                        </a>
                    </div>
                </div>
            </div>

            <!-- Right Column: Interactive Chat & Notes (4 cols) -->
            <div class="lg:col-span-4 bg-zinc-900/40 border-t lg:border-t-0 lg:border-l border-zinc-800 flex flex-col h-full max-h-[480px] lg:max-h-full">
                <!-- Tab Headers -->
                <div class="flex border-b border-zinc-800 bg-zinc-900/60 p-1">
                    <button type="button" id="tab-notes-btn" onclick="window.switchWatchTab('notes')" class="flex-1 py-2 text-xs font-bold uppercase tracking-wider rounded-lg bg-zinc-800 text-white transition-colors">
                        Sermon Notes
                    </button>
                    <button type="button" id="tab-prayer-btn" onclick="window.switchWatchTab('prayer')" class="flex-1 py-2 text-xs font-bold uppercase tracking-wider rounded-lg text-zinc-400 hover:text-white transition-colors">
                        Live Prayer
                    </button>
                </div>

                <!-- Tab 1: Sermon Notes -->
                <div id="tab-notes-content" class="p-4 sm:p-5 flex-1 overflow-y-auto space-y-4 text-xs sm:text-sm">
                    <div class="p-3 rounded-xl bg-zinc-900 border border-zinc-800">
                        <span class="text-[10px] uppercase font-bold text-amber-400 tracking-wider">Primary Scripture</span>
                        <div class="text-zinc-200 font-semibold mt-1">Colossians 1:28 · 2 Corinthians 9:7</div>
                        <p class="text-zinc-400 text-xs mt-1 italic">
                            "Him we proclaim, warning everyone and teaching everyone with all wisdom, that we may present everyone mature in Christ."
                        </p>
                    </div>

                    <div class="space-y-3">
                        <div class="font-heading uppercase tracking-wider text-xs font-bold text-zinc-200">Key Takeaways</div>
                        <ul class="space-y-2.5 text-zinc-300 text-xs leading-relaxed list-disc list-inside">
                            <li><strong class="text-white">Wholistic Growth:</strong> God is not merely interested in Sunday attendance; He desires transformation in our marriages, careers, and spiritual depth.</li>
                            <li><strong class="text-white">The Call to Mission:</strong> We are blessed to become a conduit of blessing to Montgomery County and the nations.</li>
                            <li><strong class="text-white">Rooted in Prayer:</strong> Every breakthrough is birthed in consistent, communal intercession.</li>
                        </ul>
                    </div>

                    <div class="pt-2">
                        <a href="/about#beliefs" class="block text-center py-2 px-3 rounded-lg bg-zinc-800/80 hover:bg-zinc-800 text-zinc-300 hover:text-white text-xs font-medium transition-colors">
                            Read Statement of Faith &rarr;
                        </a>
                    </div>
                </div>

                <!-- Tab 2: Live Prayer Request -->
                <div id="tab-prayer-content" class="hidden p-4 sm:p-5 flex-1 overflow-y-auto space-y-3">
                    <p class="text-xs text-zinc-400">
                        Our pastoral care team and prayer partners are actively praying for requests submitted during broadcast.
                    </p>
                    <form id="watch-prayer-form" onsubmit="window.submitWatchPrayer(event); return false;" class="space-y-3">
                        <input type="text" id="watch-prayer-name" placeholder="Your Name" required class="w-full px-3 py-2 rounded-xl bg-zinc-900 border border-zinc-700 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-amber-400">
                        <input type="email" id="watch-prayer-email" placeholder="Your Email" required class="w-full px-3 py-2 rounded-xl bg-zinc-900 border border-zinc-700 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-amber-400">
                        <textarea id="watch-prayer-text" rows="3" placeholder="How can we pray for you today?" required class="w-full px-3 py-2 rounded-xl bg-zinc-900 border border-zinc-700 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-amber-400"></textarea>
                        
                        <div id="watch-prayer-status" class="hidden text-xs p-2 rounded-lg"></div>

                        <button type="submit" id="watch-prayer-submit" class="w-full py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-zinc-950 font-bold text-xs uppercase tracking-wider transition-all">
                            Send Prayer Request
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
window.openWatchModal = function() {
    const modal = document.getElementById('watch-online-modal');
    if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }
};

window.closeWatchModal = function() {
    const modal = document.getElementById('watch-online-modal');
    if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
    }
};

window.switchWatchTab = function(tabName) {
    const notesBtn = document.getElementById('tab-notes-btn');
    const prayerBtn = document.getElementById('tab-prayer-btn');
    const notesContent = document.getElementById('tab-notes-content');
    const prayerContent = document.getElementById('tab-prayer-content');

    if (tabName === 'notes') {
        notesBtn.className = 'flex-1 py-2 text-xs font-bold uppercase tracking-wider rounded-lg bg-zinc-800 text-white transition-colors';
        prayerBtn.className = 'flex-1 py-2 text-xs font-bold uppercase tracking-wider rounded-lg text-zinc-400 hover:text-white transition-colors';
        notesContent.classList.remove('hidden');
        prayerContent.classList.add('hidden');
    } else {
        prayerBtn.className = 'flex-1 py-2 text-xs font-bold uppercase tracking-wider rounded-lg bg-zinc-800 text-white transition-colors';
        notesBtn.className = 'flex-1 py-2 text-xs font-bold uppercase tracking-wider rounded-lg text-zinc-400 hover:text-white transition-colors';
        prayerContent.classList.remove('hidden');
        notesContent.classList.add('hidden');
    }
};

window.submitWatchPrayer = async function(e) {
    if (e && e.preventDefault) e.preventDefault();
    const name = document.getElementById('watch-prayer-name').value;
    const email = document.getElementById('watch-prayer-email').value;
    const text = document.getElementById('watch-prayer-text').value;
    const statusBox = document.getElementById('watch-prayer-status');
    const submitBtn = document.getElementById('watch-prayer-submit');

    if (!name || !email || !text) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';

    try {
        const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                name: name,
                email: email,
                inquiry_type: 'prayer',
                message: '[WATCH ONLINE PRAYER] ' + text
            })
        });

        if (res.ok) {
            statusBox.className = 'text-xs p-2.5 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
            statusBox.textContent = 'Prayer request received! Our team is standing in faith with you.';
            statusBox.classList.remove('hidden');
            document.getElementById('watch-prayer-text').value = '';
        } else {
            statusBox.className = 'text-xs p-2.5 rounded-lg bg-red-500/20 text-red-300 border border-red-500/30';
            statusBox.textContent = 'Failed to submit. Please try again.';
            statusBox.classList.remove('hidden');
        }
    } catch (err) {
        statusBox.className = 'text-xs p-2.5 rounded-lg bg-red-500/20 text-red-300 border border-red-500/30';
        statusBox.textContent = 'Network error. Please try again.';
        statusBox.classList.remove('hidden');
    } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Prayer Request';
    }
};
</script>
