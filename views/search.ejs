<%- include('partials/header', { 
    metaTitle: 'Search EUCMD Young Adults & Church Resources',
    metaDesc: 'Search teachings, scripture memory, events, and ministries at Emmanuel United Church of Maryland.',
    currentPath: '/search'
}) %>
<%- include('partials/navbar') %>

<main id="main-content" class="min-h-screen text-white pt-28 pb-20 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto flex-1 w-full relative overflow-hidden">

    <!-- Ambient Cosmic Spotlight Beams -->
    <div class="pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[550px] bg-gradient-to-b from-cyan-400/20 via-sky-500/10 to-transparent blur-3xl -z-10"></div>
    <div class="pointer-events-none absolute top-1/3 -left-32 w-96 h-96 bg-sky-500/15 rounded-full blur-3xl -z-10"></div>
    <div class="pointer-events-none absolute top-2/3 -right-32 w-96 h-96 bg-cyan-400/15 rounded-full blur-3xl -z-10"></div>

    <!-- Header & Search Input -->
    <div class="mb-10 text-center sm:text-left">
        <div class="azure-pill inline-flex items-center gap-2 mb-3">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
            <span>Site Search Engine</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-black text-white uppercase tracking-tight mb-4">
            Search EUCMD Resources
        </h1>
        <p class="text-slate-300 text-sm sm:text-base max-w-2xl leading-relaxed mb-6">
            Find discipleship teachings, scripture verses, upcoming gatherings, small groups, campus carpools, and ministry info.
        </p>

        <!-- Search Bar Form in Azure Glass Container -->
        <form action="/search" method="GET" class="relative w-full max-w-3xl">
            <div class="azure-inner-card relative flex items-center border border-white/20 p-2 focus-within:border-cyan-400 focus-within:shadow-[0_0_20px_rgba(0,229,255,0.3)] transition-all">
                <span class="text-cyan-400 pl-3 pr-2">
                    <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </span>
                <input type="text" 
                       name="q" 
                       id="page-search-input"
                       value="<%= typeof q !== 'undefined' ? q : '' %>" 
                       placeholder="Search salvation, small groups, worship, prayer, scriptures..." 
                       class="w-full bg-transparent text-white placeholder-slate-400 text-base sm:text-lg font-medium focus:outline-none border-none py-2 px-1"
                       autocomplete="off"
                       autofocus>
                
                <% if (typeof q !== 'undefined' && q) { %>
                    <a href="/search" class="p-2 text-slate-400 hover:text-white mr-1" title="Clear search">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </a>
                <% } %>

                <button type="submit" class="azure-primary-btn px-6 sm:px-8 py-2.5 sm:py-3 text-xs sm:text-sm uppercase tracking-wider shrink-0 cursor-pointer">
                    Search
                </button>
            </div>

            <!-- Category Filter Pills -->
            <div class="flex items-center gap-1.5 sm:gap-2 mt-4 overflow-x-auto no-scrollbar py-1 text-xs">
                <span class="text-slate-400 font-semibold shrink-0 mr-1 font-mono uppercase text-[10px]">Filter:</span>
                <a href="/search?q=<%= encodeURIComponent(typeof q !== 'undefined' ? q : '') %>&category=all" 
                   class="px-3.5 py-1.5 rounded-full font-heading font-bold text-xs uppercase tracking-wider transition-all shrink-0 <%= (typeof category === 'undefined' || category === 'all' || !category) ? 'bg-cyan-400 text-slate-950 shadow-[0_0_12px_rgba(0,229,255,0.5)]' : 'bg-white/10 text-slate-300 hover:bg-white/20' %>">
                    All Results
                </a>
                <a href="/search?q=<%= encodeURIComponent(typeof q !== 'undefined' ? q : '') %>&category=teachings" 
                   class="px-3.5 py-1.5 rounded-full font-heading font-bold text-xs uppercase tracking-wider transition-all shrink-0 <%= (typeof category !== 'undefined' && category === 'teachings') ? 'bg-cyan-400 text-slate-950 shadow-[0_0_12px_rgba(0,229,255,0.5)]' : 'bg-white/10 text-slate-300 hover:bg-white/20' %>">
                    Teachings
                </a>
                <a href="/search?q=<%= encodeURIComponent(typeof q !== 'undefined' ? q : '') %>&category=events" 
                   class="px-3.5 py-1.5 rounded-full font-heading font-bold text-xs uppercase tracking-wider transition-all shrink-0 <%= (typeof category !== 'undefined' && category === 'events') ? 'bg-cyan-400 text-slate-950 shadow-[0_0_12px_rgba(0,229,255,0.5)]' : 'bg-white/10 text-slate-300 hover:bg-white/20' %>">
                    Events
                </a>
                <a href="/search?q=<%= encodeURIComponent(typeof q !== 'undefined' ? q : '') %>&category=groups" 
                   class="px-3.5 py-1.5 rounded-full font-heading font-bold text-xs uppercase tracking-wider transition-all shrink-0 <%= (typeof category !== 'undefined' && category === 'groups') ? 'bg-cyan-400 text-slate-950 shadow-[0_0_12px_rgba(0,229,255,0.5)]' : 'bg-white/10 text-slate-300 hover:bg-white/20' %>">
                    Small Groups
                </a>
                <a href="/search?q=<%= encodeURIComponent(typeof q !== 'undefined' ? q : '') %>&category=scriptures" 
                   class="px-3.5 py-1.5 rounded-full font-heading font-bold text-xs uppercase tracking-wider transition-all shrink-0 <%= (typeof category !== 'undefined' && category === 'scriptures') ? 'bg-cyan-400 text-slate-950 shadow-[0_0_12px_rgba(0,229,255,0.5)]' : 'bg-white/10 text-slate-300 hover:bg-white/20' %>">
                    Scriptures
                </a>
                <a href="/search?q=<%= encodeURIComponent(typeof q !== 'undefined' ? q : '') %>&category=faqs" 
                   class="px-3.5 py-1.5 rounded-full font-heading font-bold text-xs uppercase tracking-wider transition-all shrink-0 <%= (typeof category !== 'undefined' && category === 'faqs') ? 'bg-cyan-400 text-slate-950 shadow-[0_0_12px_rgba(0,229,255,0.5)]' : 'bg-white/10 text-slate-300 hover:bg-white/20' %>">
                    FAQs
                </a>
            </div>
        </form>
    </div>

    <!-- Results Section -->
    <div class="mt-8">
        <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-6">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-cyan-300">
                <% if (typeof q !== 'undefined' && q) { %>
                    Found <%= typeof results !== 'undefined' ? results.length : 0 %> results for "<%= q %>"
                <% } else { %>
                    Featured Discoveries (<%= typeof results !== 'undefined' ? results.length : 0 %>)
                <% } %>
            </span>
            <span class="text-xs text-slate-400 font-mono">Click card to open</span>
        </div>

        <% if (typeof results !== 'undefined' && results.length > 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <% results.forEach(item => { %>
                    <a href="<%= item.url %>" class="group flex items-start gap-4 p-5 rounded-2xl azure-inner-card hover:border-cyan-400/50 hover:shadow-[0_0_20px_rgba(0,229,255,0.2)] transition-all text-left relative overflow-hidden active:scale-[0.99]">
                        <div class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-2xl shrink-0 group-hover:scale-110 transition-transform shadow-sm">
                            <%= item.icon || '📄' %>
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2 mb-1.5">
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase tracking-wider bg-cyan-400/15 text-cyan-300 border border-cyan-400/30">
                                    <%= item.pillar %>
                                </span>
                            </div>
                            <h3 class="text-base font-heading font-bold text-white group-hover:text-cyan-300 transition-colors leading-snug mb-1">
                                <%= item.title %>
                            </h3>
                            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed line-clamp-2">
                                <%= item.desc %>
                            </p>
                        </div>
                        <span class="text-slate-400 group-hover:text-cyan-400 group-hover:translate-x-1 transition-all text-lg mt-2 shrink-0">
                            &rarr;
                        </span>
                    </a>
                <% }) %>
            </div>
        <% } else { %>
            <div class="py-16 text-center azure-inner-card p-8">
                <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-cyan-400/10 text-cyan-300 border border-cyan-400/20 flex items-center justify-center text-3xl">
                    🔍
                </div>
                <h3 class="text-xl font-heading font-bold text-white mb-2 uppercase">No matching results found</h3>
                <p class="text-sm text-slate-300 max-w-md mx-auto mb-6">
                    We couldn't find anything matching your search. Try searching with different keywords like salvation, small groups, prayer, or worship.
                </p>
                <div class="flex flex-wrap items-center justify-center gap-2">
                    <a href="/search?q=salvation" class="px-3.5 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-mono text-cyan-300 transition-colors">Salvation</a>
                    <a href="/search?q=small+groups" class="px-3.5 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-mono text-cyan-300 transition-colors">Small Groups</a>
                    <a href="/search?q=prayer" class="px-3.5 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-mono text-cyan-300 transition-colors">Prayer</a>
                    <a href="/search?q=baptism" class="px-3.5 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-mono text-cyan-300 transition-colors">Baptism</a>
                </div>
            </div>
        <% } %>
    </div>
</main>

<%- include('partials/footer') %>
