<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main id="main-content" class="min-h-screen pt-28 pb-20 text-white selection:bg-cyan-500 selection:text-slate-950 relative overflow-hidden">
    <!-- Ambient Celestial Azure Aurora Spotlight Flares -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
        <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[900px] h-[600px] bg-sky-500/18 rounded-full filter blur-[150px]"></div>
        <div class="absolute top-1/3 -right-40 w-[600px] h-[600px] bg-cyan-400/14 rounded-full filter blur-[160px]"></div>
        <div class="absolute bottom-10 left-1/4 w-[550px] h-[550px] bg-blue-700/16 rounded-full filter blur-[150px]"></div>
    </div>

    <!-- Header Hero Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-10 relative z-10">
        <div class="relative overflow-hidden rounded-[2.5rem] azure-glass-shell p-8 sm:p-12 border border-sky-400/30 shadow-2xl">
            <div class="diamond-glint top-8 right-8 hidden sm:block"></div>
            <div class="relative z-10 max-w-3xl">
                <div class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan-300 mb-3 flex items-center gap-2">
                    <span>Emmanuel United Church of Maryland</span>
                    <span aria-hidden="true" class="text-white/40">·</span>
                    <span>Community Calendar & Gatherings</span>
                </div>
                <h1 class="text-3xl sm:text-5xl lg:text-6xl font-heading font-black tracking-tight mb-4 text-white uppercase">
                    Upcoming Gatherings & Events.
                </h1>
                <p class="text-sky-100/90 text-sm sm:text-base leading-relaxed mb-6 font-normal">
                    Experience authentic fellowship, passionate worship, intentional discipleship, and city impact across Maryland. Browse upcoming gatherings, check schedules, and reserve your spot.
                </p>
                
                <!-- Quick Stats Strip -->
                <div class="flex flex-wrap items-center gap-y-2 gap-x-4 pt-4 border-t border-sky-400/20 text-xs text-sky-200/80">
                    <span class="text-white font-medium">
                        <strong class="font-bold text-cyan-300" id="stat-total-events"><%= (events || []).length %></strong> Upcoming Events
                    </span>
                    <span aria-hidden="true" class="text-white/30">·</span>
                    <span>
                        <strong class="font-bold text-cyan-300" id="stat-total-rsvps"><%= (events || []).reduce((acc, e) => acc + (e.rsvp_count || 0), 0) %></strong> Confirmed RSVPs
                    </span>
                    <span aria-hidden="true" class="text-white/30">·</span>
                    <span>Free Admission (Zero Registration Fees)</span>
                    <span aria-hidden="true" class="text-white/30">·</span>
                    <span>All Ages Welcome · Children's Care Available</span>
                </div>
            </div>
        </div>
    </section>

    <!-- User's Official Upcoming Church Events Highlight -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-10 relative z-10">
        <div class="p-8 sm:p-12 rounded-[2.5rem] azure-glass-shell border border-sky-400/30 shadow-2xl text-white relative overflow-hidden">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
                <div>
                    <span class="text-xs font-heading font-bold uppercase tracking-widest text-cyan-300">
                        Mark Your Calendars
                    </span>
                    <h2 class="text-2xl sm:text-4xl font-heading font-black uppercase text-white tracking-tight mt-1">
                        Great Events Coming Up
                    </h2>
                </div>
                <a href="#calendar-section" class="text-xs font-heading font-bold uppercase tracking-wider text-cyan-300 hover:text-white transition-colors flex items-center gap-1">
                    <span>View Full Monthly Calendar</span>
                    <span>&darr;</span>
                </a>
            </div>

            <!-- FEATURED COMING SOON EVENT: End Time Educational Conference (የመጨረሻው ዘመን ትምህርታዊ ኮንፈረንስ) -->
            <div class="mb-8 rounded-3xl azure-inner-card border border-sky-400/40 p-6 sm:p-8 relative overflow-hidden shadow-2xl backdrop-blur-3xl group">
                <div class="diamond-glint top-6 right-6 hidden sm:block"></div>
                <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-center relative z-10">
                    
                    <!-- Flyer Visual Preview -->
                    <div class="lg:col-span-4">
                        <div class="aspect-[2/3] max-w-[280px] mx-auto rounded-2xl overflow-hidden border border-sky-400/40 shadow-2xl relative group/flyer cursor-pointer bg-slate-950/60" onclick="window.openRsvpModal && window.openRsvpModal(6)">
                            <img 
                                src="/assets/aistudio/END_TIME_c42ac03e.jpg" 
                                alt="የመጨረሻው ዘመን ትምህርታዊ ኮንፈረንስ - End Time Educational Conference" 
                                class="w-full h-full object-cover group-hover/flyer:scale-105 transition-transform duration-700 brightness-[0.98]"
                            >
                            <div class="absolute inset-0 bg-gradient-to-t from-[#060d1d]/90 via-transparent to-transparent pointer-events-none"></div>
                            
                            <div class="absolute bottom-3 left-3 right-3 p-2.5 rounded-xl bg-[#09152e]/85 backdrop-blur-xl border border-sky-400/35 flex items-center justify-between text-xs text-sky-200">
                                <span class="font-heading font-bold uppercase text-[10px] tracking-wider text-cyan-300">
                                    Official Flyer
                                </span>
                                <span class="font-bold text-amber-300 uppercase text-[10px] px-2 py-0.5 rounded-full bg-amber-400/15 border border-amber-400/30">Entry Free</span>
                            </div>
                        </div>
                    </div>

                    <!-- Conference Details -->
                    <div class="lg:col-span-8 space-y-4">
                        
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-gradient-to-r from-amber-500/20 to-sky-500/20 border border-amber-400/40 text-amber-300 text-[11px] font-heading font-black uppercase tracking-wider shadow-md">
                                <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
                                Coming Soon Event
                            </span>
                            <span class="px-3 py-1 rounded-full bg-white/[0.08] border border-sky-400/30 text-sky-200 text-[11px] font-heading font-bold uppercase tracking-wider">
                                Nov 13, 14 & 15, 2026
                            </span>
                            <span class="px-3 py-1 rounded-full bg-cyan-400/15 border border-cyan-400/35 text-cyan-300 text-[11px] font-heading font-bold uppercase tracking-wider">
                                All Ages · Free Admission
                            </span>
                        </div>

                        <div>
                            <h3 class="text-2xl sm:text-3xl md:text-4xl font-ethiopic font-bold text-amber-300 leading-tight">
                                የመጨረሻው ዘመን ትምህርታዊ ኮንፈረንስ
                            </h3>
                            <h4 class="text-xl sm:text-2xl font-heading font-black uppercase text-white tracking-tight mt-0.5">
                                End Time Educational Conference
                            </h4>
                            <p class="text-xs sm:text-sm text-sky-200/80 font-sans mt-2 leading-relaxed">
                                Three historic days of biblical prophetic teaching, apostolic revelation, fervent intercession, and heavenly worship.
                            </p>
                        </div>

                        <!-- Ministers -->
                        <div class="p-3.5 rounded-2xl bg-[#09152e]/80 border border-sky-400/25 space-y-1.5">
                            <span class="text-[10px] font-heading font-bold uppercase tracking-widest text-cyan-300 block">
                                Featured Ministers & Worship Leaders
                            </span>
                            <div class="flex flex-wrap gap-1.5 text-[11px] font-heading uppercase tracking-wide">
                                <span class="px-2.5 py-0.5 rounded-lg bg-white/[0.08] border border-sky-400/30 text-white font-bold">
                                    Pastor Dr. Tesfa Workneh
                                </span>
                                <span class="px-2.5 py-0.5 rounded-lg bg-white/[0.08] border border-sky-400/30 text-white font-bold">
                                    Pastor Dr. Bezalem Fisseha
                                </span>
                                <span class="px-2.5 py-0.5 rounded-lg bg-white/[0.08] border border-sky-400/30 text-white font-bold">
                                    Brother Sisay
                                </span>
                                <span class="px-2.5 py-0.5 rounded-lg bg-white/[0.08] border border-sky-400/30 text-white font-bold">
                                    Pastor Abrham
                                </span>
                                <span class="px-2.5 py-0.5 rounded-lg bg-cyan-500/20 border border-cyan-400/40 text-cyan-200 font-bold">
                                    Singer Nebiyat
                                </span>
                                <span class="px-2.5 py-0.5 rounded-lg bg-cyan-500/20 border border-cyan-400/40 text-cyan-200 font-bold">
                                    Singer Solomon
                                </span>
                            </div>
                        </div>

                        <!-- 2 Session Locations -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div class="p-3 rounded-xl bg-slate-950/60 border border-sky-400/25">
                                <div class="text-[10px] font-heading font-bold uppercase text-amber-300">Days 1 & 2 · Fri & Sat, Nov 13 & 14</div>
                                <div class="text-xs font-heading font-bold text-white mt-0.5">7:00 PM EST</div>
                                <div class="text-[11px] text-sky-200/75 mt-0.5">914 Silver Spring Ave, Ste 204B, Silver Spring, MD</div>
                            </div>
                            <div class="p-3 rounded-xl bg-slate-950/60 border border-cyan-400/25">
                                <div class="text-[10px] font-heading font-bold uppercase text-cyan-300">Day 3 · Sun, Nov 15 (Grand Finale)</div>
                                <div class="text-xs font-heading font-bold text-white mt-0.5">10:00 AM EST</div>
                                <div class="text-[11px] text-sky-200/75 mt-0.5">12604 New Hampshire Ave, Silver Spring, MD</div>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="pt-2 flex flex-wrap items-center gap-3">
                            <button type="button" onclick="window.openRsvpModal && window.openRsvpModal(6)" class="px-6 py-3 rounded-full azure-primary-btn text-white font-heading font-bold text-xs uppercase tracking-wider transition-all shadow-md active:scale-95 cursor-pointer">
                                Reserve Free Spot (RSVP) &rarr;
                            </button>
                            <a href="https://maps.google.com/?q=914+Silver+Spring+Ave+204B,+Silver+Spring,+MD+20910" target="_blank" rel="noopener noreferrer" class="px-5 py-3 rounded-full azure-pill text-white font-heading font-bold text-xs uppercase tracking-wider border border-sky-400/30">
                                Get Directions
                            </a>
                        </div>

                    </div>

                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                <!-- Event 1: Sunday Worship Services -->
                <div class="rounded-3xl azure-inner-card border border-sky-400/25 hover:border-sky-400/50 transition-all flex flex-col sm:flex-row overflow-hidden shadow-xl">
                    <div class="sm:w-44 aspect-video sm:aspect-auto overflow-hidden relative shrink-0">
                        <img src="/assets/aistudio/484072894_1063741372448335_893225315921763014_n_f89cea15.jpg" alt="Sunday Worship Services" class="w-full h-full object-cover brightness-95">
                        <div class="absolute top-3 left-3 flex flex-col items-center justify-center w-12 h-12 rounded-xl bg-gradient-to-tr from-sky-600 to-cyan-500 text-white font-heading font-black shadow-md border border-white/20">
                            <span class="text-[9px] uppercase tracking-wider leading-none text-sky-100">Nov</span>
                            <span class="text-base leading-none mt-0.5">8</span>
                        </div>
                    </div>
                    <div class="p-6 space-y-1.5 flex-1">
                        <span class="text-[10px] font-heading font-bold uppercase tracking-widest text-cyan-300">Corporate Worship</span>
                        <h3 class="text-lg sm:text-xl font-heading font-bold uppercase text-white">Sunday Worship Services</h3>
                        <div class="text-xs text-sky-200/90 font-sans">
                            <strong class="text-white">10:30 AM</strong> · 12604 New Hampshire Ave, Silver Spring, MD 20904
                        </div>
                        <p class="text-xs text-sky-200/70 font-sans pt-1">
                            Uplifting corporate worship, joyful praise, intercessory prayer, and expository biblical preaching. Kingdom Kids check-in starts at 10:15 AM.
                        </p>
                    </div>
                </div>

                <!-- Event 2: Prayer Services -->
                <div class="rounded-3xl azure-inner-card border border-sky-400/25 hover:border-sky-400/50 transition-all flex flex-col sm:flex-row overflow-hidden shadow-xl">
                    <div class="sm:w-44 aspect-video sm:aspect-auto overflow-hidden relative shrink-0">
                        <img src="/assets/aistudio/762868473_1483868947102240_2914173873595455190_n_eb792f44.jpg" alt="Midweek Prayer Services" class="w-full h-full object-cover brightness-95">
                        <div class="absolute top-3 left-3 flex flex-col items-center justify-center w-12 h-12 rounded-xl bg-sky-950/80 border border-sky-400/40 text-white font-heading font-black shadow-md">
                            <span class="text-[9px] uppercase tracking-wider leading-none text-cyan-300">Nov</span>
                            <span class="text-base leading-none mt-0.5">11</span>
                        </div>
                    </div>
                    <div class="p-6 space-y-1.5 flex-1">
                        <span class="text-[10px] font-heading font-bold uppercase tracking-widest text-sky-300">Midweek Intercession</span>
                        <h3 class="text-lg sm:text-xl font-heading font-bold uppercase text-white">Prayer Services</h3>
                        <div class="text-xs text-sky-200/90 font-sans">
                            <strong class="text-white">11:00 AM</strong> · 914 Silver Spring Ave, Suite 204B, Silver Spring, MD 20910
                        </div>
                        <p class="text-xs text-sky-200/70 font-sans pt-1">
                            Midweek corporate intercession, fasting, spiritual renewal, personal counseling, and administrative coordination with Pastor Dr. Bezalem.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Scripture Encouragement: Nehemiah 2:20 -->
            <div class="p-6 rounded-2xl azure-inner-card border border-sky-400/20 text-center space-y-2">
                <blockquote class="text-base sm:text-lg font-serif italic text-sky-200">
                    "The God of heaven will make us prosper, and we his servants will arise and build...”
                </blockquote>
                <div class="text-xs font-heading font-bold uppercase tracking-widest text-cyan-300">
                    — Nehemiah 2:20
                </div>
            </div>
        </div>
    </section>

    <!-- Calendar Controls & Filters Bar -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8 relative z-10">
        <div class="azure-glass-shell rounded-2xl p-4 sm:p-5 border border-sky-400/25 shadow-xl flex flex-col md:flex-row md:items-center justify-between gap-4">
            
            <!-- Category Chips -->
            <div class="flex items-center gap-2 overflow-x-auto pb-2 md:pb-0 scrollbar-none" id="category-filters">
                <button type="button" data-category="all" class="category-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all whitespace-nowrap bg-cyan-400 text-slate-950 shadow-md">
                    All Events
                </button>
                <button type="button" data-category="gathering" class="category-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all whitespace-nowrap text-sky-200 hover:text-white hover:bg-sky-500/20">
                    Tuesday Gathering
                </button>
                <button type="button" data-category="prayer" class="category-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all whitespace-nowrap text-sky-200 hover:text-white hover:bg-sky-500/20">
                    Worship & Prayer
                </button>
                <button type="button" data-category="fellowship" class="category-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all whitespace-nowrap text-sky-200 hover:text-white hover:bg-sky-500/20">
                    Tribal Fellowship
                </button>
                <button type="button" data-category="service" class="category-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all whitespace-nowrap text-sky-200 hover:text-white hover:bg-sky-500/20">
                    City Outreach
                </button>
                <button type="button" data-category="retreat" class="category-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all whitespace-nowrap text-sky-200 hover:text-white hover:bg-sky-500/20">
                    Retreats
                </button>
            </div>

            <!-- View Switcher & Search -->
            <div class="flex items-center gap-3 shrink-0">
                <div class="relative w-full sm:w-60">
                    <input type="text" id="search-input" placeholder="Search events..." class="w-full pl-9 pr-4 py-2 rounded-xl text-xs sm:text-sm bg-[#060d1d]/80 border border-sky-400/25 text-white placeholder-sky-300/40 focus:outline-none focus:ring-2 focus:ring-cyan-400">
                    <svg class="w-4 h-4 text-sky-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </div>

                <!-- View Switch Toggle (Calendar Grid vs Agenda List) -->
                <div class="flex items-center p-1 bg-[#0a1428] rounded-xl border border-sky-400/25 shrink-0">
                    <button type="button" id="toggle-calendar-view" title="Calendar View" class="p-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all bg-sky-500/20 text-cyan-300 border border-sky-400/30 shadow-xs">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        <span class="hidden sm:inline">Calendar</span>
                    </button>
                    <button type="button" id="toggle-cards-view" title="List View" class="p-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all text-sky-300/70 hover:text-white">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
                        <span class="hidden sm:inline">List</span>
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Container: Calendar Grid & Agenda List -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Interactive Monthly Calendar View Component -->
        <div id="calendar-section" class="azure-glass-shell rounded-3xl border border-sky-400/25 shadow-2xl p-4 sm:p-8 mb-10 transition-all">
            <!-- Calendar Navigation Header -->
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-sky-400/20">
                <div class="flex items-center gap-3">
                    <h2 id="calendar-month-year" class="text-xl sm:text-2xl font-black text-white">
                        <!-- e.g. September 2026 -->
                    </h2>
                    <span id="calendar-active-filter-badge" class="hidden px-2.5 py-0.5 rounded-full text-xs font-semibold bg-sky-500/20 text-cyan-300 border border-sky-400/30"></span>
                </div>
                
                <div class="flex items-center gap-1.5">
                    <button type="button" id="cal-prev-btn" class="p-2 rounded-xl border border-sky-400/25 hover:bg-sky-500/10 text-sky-200 hover:text-white transition-colors" title="Previous Month">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                    </button>
                    <button type="button" id="cal-today-btn" class="px-3 py-1.5 text-xs font-bold rounded-xl border border-sky-400/25 hover:bg-sky-500/10 text-cyan-300 transition-colors">
                        Today
                    </button>
                    <button type="button" id="cal-next-btn" class="p-2 rounded-xl border border-sky-400/25 hover:bg-sky-500/10 text-sky-200 hover:text-white transition-colors" title="Next Month">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    </button>
                </div>
            </div>

            <!-- Days of Week Header -->
            <div class="grid grid-cols-7 gap-1 sm:gap-2 mb-2 text-center text-xs font-bold uppercase tracking-wider text-sky-300/70">
                <span class="py-2">Sun</span>
                <span class="py-2">Mon</span>
                <span class="py-2">Tue</span>
                <span class="py-2">Wed</span>
                <span class="py-2">Thu</span>
                <span class="py-2">Fri</span>
                <span class="py-2">Sat</span>
            </div>

            <!-- Calendar Days Grid -->
            <div id="calendar-days-grid" class="grid grid-cols-7 gap-1 sm:gap-2">
                <!-- Dynamically populated by JS -->
            </div>

            <!-- Selected Date Filter Banner (If user clicks a specific day) -->
            <div id="date-filter-banner" class="hidden mt-4 p-3 rounded-2xl bg-sky-950/60 border border-sky-400/30 flex items-center justify-between text-xs sm:text-sm text-sky-200">
                <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
                    <span>Showing events for: <strong id="filter-date-text" class="text-white"></strong></span>
                </div>
                <button type="button" id="clear-date-filter" class="font-bold text-cyan-300 underline hover:text-white transition-colors">
                    Show All Dates
                </button>
            </div>
        </div>

        <!-- Section Title for Upcoming Cards -->
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 class="text-xl sm:text-2xl font-black text-white">
                    Event Schedule & Registration
                </h2>
                <p class="text-xs sm:text-sm text-sky-200/70">
                    Click "RSVP Now" on any event to register yourself and your guests.
                </p>
            </div>
            <span id="events-count-badge" class="text-xs font-bold px-3 py-1 rounded-full bg-sky-500/20 text-cyan-300 border border-sky-400/30">
                <%= (events || []).length %> events
            </span>
        </div>

        <!-- Events Cards Grid -->
        <div id="events-list-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Populated dynamically via JS from events data -->
        </div>

        <!-- Empty State (When search/filter has no results) -->
        <div id="empty-state" class="hidden py-16 text-center">
            <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-sky-950/70 border border-sky-400/25 flex items-center justify-center text-cyan-300">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            </div>
            <h3 class="text-lg font-bold text-white mb-1">No Events Found</h3>
            <p class="text-sm text-sky-200/70 max-w-sm mx-auto mb-4">
                We couldn't find any gatherings matching your current filters.
            </p>
            <button type="button" id="reset-filters-btn" class="px-5 py-2.5 rounded-xl text-xs font-bold azure-primary-btn text-slate-950">
                Reset All Filters
            </button>
        </div>
    </div>
</main>

<!-- RSVP Modal Dialog -->
<div id="rsvp-modal" class="fixed inset-0 z-50 overflow-y-auto bg-black/75 backdrop-blur-md hidden flex items-center justify-center p-4">
    <div class="relative w-full max-w-lg azure-glass-shell rounded-3xl border border-sky-400/30 shadow-2xl overflow-hidden transition-all my-8">
        
        <!-- Modal Header -->
        <div class="p-6 bg-gradient-to-r from-sky-900/40 via-[#0a1832] to-transparent border-b border-sky-400/20 relative">
            <button type="button" id="close-rsvp-modal" class="absolute top-5 right-5 w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-sky-200 hover:text-white flex items-center justify-center transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
            <div id="modal-category-badge" class="inline-block px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider mb-2"></div>
            <h3 id="modal-event-title" class="text-xl sm:text-2xl font-black text-white leading-tight"></h3>
            <div class="flex flex-wrap gap-x-4 gap-y-1 mt-2 text-xs sm:text-sm text-sky-200/80">
                <span id="modal-event-date" class="flex items-center gap-1 font-semibold text-cyan-300">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    <span></span>
                </span>
                <span id="modal-event-time" class="flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <span></span>
                </span>
            </div>
            <div id="modal-event-location" class="flex items-center gap-1 text-xs text-sky-200/80 mt-1">
                <svg class="w-4 h-4 shrink-0 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                <span class="truncate"></span>
            </div>
        </div>

        <!-- Modal Body: Form View -->
        <div id="rsvp-form-container" class="p-6">
            <form id="rsvp-form" class="space-y-4">
                <input type="hidden" id="rsvp-event-id" value="">
                
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-sky-200 mb-1.5" for="rsvp-name">
                        Your Full Name <span class="text-cyan-300">*</span>
                    </label>
                    <input type="text" id="rsvp-name" required placeholder="e.g. Kidus Teshome" class="w-full px-4 py-3 rounded-xl bg-[#060d1d]/80 border border-sky-400/25 text-white placeholder-sky-300/40 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-400">
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-sky-200 mb-1.5" for="rsvp-email">
                        Email Address <span class="text-cyan-300">*</span>
                    </label>
                    <input type="email" id="rsvp-email" required placeholder="you@example.com" class="w-full px-4 py-3 rounded-xl bg-[#060d1d]/80 border border-sky-400/25 text-white placeholder-sky-300/40 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-400">
                    <p class="text-[11px] text-sky-300/60 mt-1">We'll send your event confirmation and calendar invite here.</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-zinc-600 dark:text-zinc-400 mb-1.5" for="rsvp-phone">
                            Phone Number <span class="text-zinc-400 text-[10px] font-normal">(Optional)</span>
                        </label>
                        <input type="tel" id="rsvp-phone" placeholder="(301) 555-0199" class="w-full px-4 py-3 rounded-xl bg-zinc-100 dark:bg-studio-800 border border-zinc-200 dark:border-white/10 text-zinc-900 dark:text-white placeholder-zinc-400 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-zinc-600 dark:text-zinc-400 mb-1.5" for="rsvp-guests">
                            Additional Guests
                        </label>
                        <select id="rsvp-guests" class="w-full px-4 py-3 rounded-xl bg-zinc-100 dark:bg-studio-800 border border-zinc-200 dark:border-white/10 text-zinc-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <option value="0">Just me (1 spot)</option>
                            <option value="1">+1 Guest (2 spots)</option>
                            <option value="2">+2 Guests (3 spots)</option>
                            <option value="3">+3 Guests (4 spots)</option>
                            <option value="4">+4 Guests (5 spots)</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-zinc-600 dark:text-zinc-400 mb-1.5" for="rsvp-notes">
                        Notes or Questions <span class="text-zinc-400 text-[10px] font-normal">(Optional)</span>
                    </label>
                    <textarea id="rsvp-notes" rows="2" placeholder="Dietary restrictions, prayer request, or note for the host..." class="w-full px-4 py-2.5 rounded-xl bg-zinc-100 dark:bg-studio-800 border border-zinc-200 dark:border-white/10 text-zinc-900 dark:text-white placeholder-zinc-400 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none"></textarea>
                </div>

                <!-- Zero Hidden Fees Disclosure & Consent -->
                <div class="p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-xs text-emerald-900 dark:text-emerald-300 flex items-center justify-between">
                    <span class="font-bold flex items-center gap-1.5">
                        <span>✓</span> Total Cost: $0.00 (100% Free)
                    </span>
                    <a href="/refund-policy" target="_blank" class="text-[10px] underline text-emerald-700 dark:text-emerald-400">Policy Details</a>
                </div>

                <div class="pt-1 text-left">
                    <label class="flex items-start gap-2.5 cursor-pointer select-none">
                        <input type="checkbox" id="rsvp-consent" required class="mt-1 w-4 h-4 rounded border-zinc-300 text-blue-600 focus:ring-blue-500">
                        <span class="text-xs text-zinc-600 dark:text-zinc-400 leading-normal">
                            I confirm I am 18+ (or 13–17 with parental permission) and agree to receive event reminders per the <a href="/privacy" target="_blank" class="text-blue-600 dark:text-blue-400 underline font-medium">Privacy Policy</a>.
                        </span>
                    </label>
                </div>

                <div id="rsvp-error-msg" class="hidden p-3 rounded-xl bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-900/50 text-red-600 dark:text-red-400 text-xs font-semibold"></div>

                <div class="pt-2 flex items-center justify-end gap-3">
                    <button type="button" id="cancel-modal-btn" class="px-5 py-3 rounded-xl text-sm font-semibold text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-studio-800 transition-colors">
                        Cancel
                    </button>
                    <button type="submit" id="submit-rsvp-btn" class="px-6 py-3 rounded-xl text-sm font-bold bg-blue-600 text-white hover:bg-blue-700 active:scale-95 transition-all shadow-md flex items-center gap-2">
                        <span>Confirm RSVP</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    </button>
                </div>
            </form>
        </div>

        <!-- Modal Success State -->
        <div id="rsvp-success-container" class="hidden p-8 text-center">
            <div class="w-16 h-16 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 mx-auto flex items-center justify-center mb-4">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
            </div>
            
            <h4 class="text-2xl font-black text-zinc-900 dark:text-white mb-2">You're on the list!</h4>
            <p class="text-sm text-zinc-500 dark:text-zinc-400 max-w-sm mx-auto mb-6">
                Your spot is confirmed. A reminder has been prepared for you. We look forward to gathering with you!
            </p>

            <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-studio-800/80 border border-zinc-200 dark:border-white/10 text-left mb-6 text-sm">
                <div id="success-event-title" class="font-bold text-zinc-900 dark:text-white mb-1"></div>
                <div id="success-event-datetime" class="text-xs text-blue-600 dark:text-blue-400 font-semibold mb-1"></div>
                <div id="success-event-location" class="text-xs text-zinc-500 dark:text-zinc-400"></div>
            </div>

            <!-- Instant Calendar Add Buttons -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-6">
                <a id="btn-add-gcal" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-blue-600 text-white font-bold text-xs hover:bg-blue-700 transition-colors flex items-center justify-center gap-2 shadow-sm">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11zM7 11h5v5H7z"/></svg>
                    <span>Add to Google Calendar</span>
                </a>
                <button type="button" id="btn-download-ics" class="w-full sm:w-auto px-4 py-2.5 rounded-xl border border-zinc-200 dark:border-white/10 hover:bg-zinc-100 dark:hover:bg-studio-800 text-zinc-700 dark:text-zinc-300 font-bold text-xs transition-colors flex items-center justify-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                    <span>Download .ics file</span>
                </button>
            </div>

            <button type="button" id="success-done-btn" class="w-full py-3 rounded-xl bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 font-bold text-sm hover:opacity-90 transition-opacity">
                Done
            </button>
        </div>
    </div>
</div>

<!-- Cancel RSVP Modal -->
<div id="cancel-rsvp-modal" class="fixed inset-0 z-50 overflow-y-auto bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="relative w-full max-w-md bg-white dark:bg-studio-900 rounded-3xl border border-zinc-200 dark:border-white/10 shadow-2xl p-6 text-zinc-900 dark:text-white">
        <h4 class="text-xl font-bold mb-2">Cancel Your RSVP</h4>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 mb-4">
            Enter the email address you used when registering to cancel your reservation and open your spot for another young adult.
        </p>
        <form id="cancel-rsvp-form" class="space-y-4">
            <input type="hidden" id="cancel-event-id" value="">
            <div>
                <label class="block text-xs font-semibold mb-1" for="cancel-email">Email Address</label>
                <input type="email" id="cancel-email" required placeholder="you@example.com" class="w-full px-4 py-2.5 rounded-xl bg-zinc-100 dark:bg-studio-800 border border-zinc-200 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-red-500">
            </div>
            <div id="cancel-error-msg" class="hidden text-xs text-red-500 font-semibold"></div>
            <div class="flex items-center justify-end gap-2 pt-2">
                <button type="button" id="close-cancel-modal" class="px-4 py-2 rounded-xl text-xs font-semibold text-zinc-500 hover:bg-zinc-100 dark:hover:bg-studio-800">
                    Keep RSVP
                </button>
                <button type="submit" id="submit-cancel-btn" class="px-4 py-2 rounded-xl text-xs font-bold bg-red-600 text-white hover:bg-red-700">
                    Confirm Cancellation
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Calendar Script -->
<script>
window.EVENTS_DATA = <%- JSON.stringify(events || []) %>;
</script>
<script src="/static/js/events-calendar.js"></script>

<%- include('partials/footer') %>
