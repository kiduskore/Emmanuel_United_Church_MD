    <!-- ======================================================== -->
    <section class="py-16 sm:py-24 relative z-10 scroll-mt-20" id="welcome-section">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Main Frosted Glass Showcase Card (Moved to the next scroll) -->
            <div class="azure-glass-shell rounded-[2.8rem] p-8 sm:p-14 relative overflow-hidden backdrop-blur-3xl shadow-2xl mb-16 text-center">
                <!-- Signature 4-Point Diamond Sparkle Glint from Attachment -->
                <div class="diamond-glint top-8 right-8 hidden sm:block"></div>
                <div class="diamond-glint bottom-12 left-8 hidden sm:block opacity-60"></div>
                <!-- Inner Specular Flare -->
                <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-36 bg-gradient-to-b from-sky-400/30 to-transparent rounded-full blur-2xl pointer-events-none"></div>

                <%
                    const serverNow = new Date();
                    const serverDay = serverNow.getDay();
                    const serverHours = serverNow.getHours();
                    let daysToSun = (7 - serverDay) % 7;
                    if (daysToSun === 0 && serverHours >= 14) {
                        daysToSun = 7;
                    }
                    const targetSun = new Date(serverNow);
                    targetSun.setDate(serverNow.getDate() + daysToSun);
                    targetSun.setHours(10, 30, 0, 0);
                    const msDiff = Math.max(0, targetSun.getTime() - serverNow.getTime());
                    const initSecs = Math.floor(msDiff / 1000);
                    const initD = Math.floor(initSecs / 86400);
                    const initH = String(Math.floor((initSecs % 86400) / 3600)).padStart(2, '0');
                    const initM = String(Math.floor((initSecs % 3600) / 60)).padStart(2, '0');
                    const initS = String(initSecs % 60).padStart(2, '0');
                    const isLiveNow = (serverDay === 0 && (serverHours > 10 || (serverHours === 10 && serverNow.getMinutes() >= 30)) && serverHours < 14);
                    const initialCountdownText = isLiveNow ? '🔴 Live Worship Now in Session' : `in ${initD}d ${initH}h ${initM}m ${initS}s · 10:30 AM`;
                %>
                <!-- Next Sunday Countdown Badge (Linkable to Plan a Visit Form) -->
                <a href="/plan-visit" onclick="if(window.openVisitModal){window.openVisitModal(); return false;}" class="inline-flex items-center gap-2.5 px-5 py-2 rounded-full bg-[#08152e]/90 backdrop-blur-xl border border-cyan-400/40 text-xs font-sans text-sky-200 mb-6 shadow-[0_0_25px_rgba(56,189,248,0.3)] hover:border-cyan-300 transition-all cursor-pointer group" title="Click to open the Plan a Visit form and reach out to us">
                    <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse shadow-[0_0_10px_#00e5ff]"></span>
                    <span class="font-heading uppercase tracking-wider font-bold text-white text-[11px] sm:text-xs">Next Sunday Service:</span>
                    <span id="hero-sunday-countdown" class="font-mono text-cyan-300 font-bold tabular-nums text-xs sm:text-sm"><%= initialCountdownText %></span>
                    <span class="text-sky-300/60 group-hover:text-cyan-300 text-xs transition-colors hidden sm:inline">&rarr; Plan Visit</span>
                </a>
                <script>
                (function() {
                    function tickSunday() {
                        var el = document.getElementById('hero-sunday-countdown');
                        if (!el) return;
                        var now = new Date();
                        var day = now.getDay();
                        var hrs = now.getHours();
                        var mins = now.getMinutes();
                        if (day === 0 && (hrs > 10 || (hrs === 10 && mins >= 30)) && hrs < 14) {
                            el.innerHTML = '<span class="text-rose-400 animate-pulse font-bold">🔴 Live Worship Now in Session</span>';
                            return;
                        }
                        var daysUntil = (7 - day) % 7;
                        if (daysUntil === 0 && hrs >= 14) daysUntil = 7;
                        var target = new Date(now);
                        target.setDate(now.getDate() + daysUntil);
                        target.setHours(10, 30, 0, 0);
                        var diff = target.getTime() - now.getTime();
                        if (diff < 0) {
                            target.setDate(target.getDate() + 7);
                            diff = target.getTime() - now.getTime();
                        }
                        var secs = Math.max(0, Math.floor(diff / 1000));
                        var d = Math.floor(secs / 86400);
                        var h = String(Math.floor((secs % 86400) / 3600)).padStart(2, '0');
                        var m = String(Math.floor((secs % 3600) / 60)).padStart(2, '0');
                        var s = String(secs % 60).padStart(2, '0');
                        el.textContent = 'in ' + d + 'd ' + h + 'h ' + m + 'm ' + s + 's · 10:30 AM';
                    }
                    tickSunday();
                    setInterval(tickSunday, 1000);
                })();
                </script>

