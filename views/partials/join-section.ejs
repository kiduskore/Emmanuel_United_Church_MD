    <section id="join" class="py-16 sm:py-24 relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
            
            <!-- Left Info Column -->
            <div class="lg:col-span-5 space-y-6">
                <div>
                    <div class="azure-pill inline-flex items-center gap-2 mb-3">
                        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                        <span><%= typeof t !== 'undefined' ? t('connect.tag') : 'Connect With Us' %></span>
                    </div>
                    <h2 class="text-3xl sm:text-5xl font-heading font-black tracking-tight text-white uppercase leading-tight mb-4">
                        We would love to welcome you.
                    </h2>
                    <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
                        Whether you are visiting for the first time, looking for a life pod in your neighborhood, or have questions about faith in Christ, reach out to our team.
                    </p>
                </div>
                
                <div class="space-y-4">
                    <!-- Tuesday Gathering Box -->
                    <div class="azure-inner-card p-6 space-y-2 border border-cyan-400/25">
                        <span class="text-xs font-mono font-bold uppercase tracking-wider text-cyan-400 block">Weekly Young Adults Gathering</span>
                        <h3 class="font-heading font-bold text-white text-lg uppercase">
                            Tuesday Nights at 7:30 PM
                        </h3>
                        <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
                            914 Silver Spring Ave, Suite 204B, Silver Spring, MD 20910.<br/>
                            Followed by fellowship, tea, coffee, and prayer circles.
                        </p>
                        <a href="https://maps.google.com/?q=914+Silver+Spring+Ave+204B,+Silver+Spring,+MD+20910" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-mono text-cyan-300 hover:text-white transition-colors pt-1">
                            <span>Get Directions (Google Maps)</span>
                            <span aria-hidden="true">&rarr;</span>
                        </a>
                    </div>

                    <!-- Sunday Church Service Box -->
                    <div class="azure-inner-card p-6 space-y-2 border border-white/10">
                        <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-400 block">Sunday Worship with EUC Church Family</span>
                        <h3 class="font-heading font-bold text-white text-lg uppercase">
                            Sundays at 10:30 AM
                        </h3>
                        <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
                            Emmanuel United Church of Maryland<br/>
                            12604 New Hampshire Ave, Silver Spring, MD 20904
                        </p>
                        <a href="/" class="inline-flex items-center gap-1.5 text-xs font-mono text-cyan-300 hover:text-white transition-colors pt-1">
                            <span>View EUC Church Home</span>
                            <span aria-hidden="true">&rarr;</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Contact Form Card -->
            <div id="contact" class="lg:col-span-7 azure-glass-shell p-8 sm:p-10 relative overflow-hidden">
                <div class="diamond-glint" style="top: 1.5rem; right: 2rem;"></div>

                <div class="mb-6">
                    <span class="text-xs font-mono font-bold uppercase tracking-wider text-cyan-400 block mb-1">
                        Direct Pastoral Inquiry
                    </span>
                    <h3 class="text-2xl font-heading font-black tracking-tight text-white uppercase">
                        <%= typeof t !== 'undefined' ? t('contact.tag') : 'Send a Note to Our Leadership' %>
                    </h3>
                    <p class="text-xs text-slate-300 mt-1">
                        <%= typeof t !== 'undefined' ? t('contact.subtitle') : 'Share your details and one of our pastors or life pod leaders will personally connect with you.' %>
                    </p>
                </div>

                <form id="contact-form" class="space-y-4">
                    <div>
                        <label class="block text-xs font-mono font-bold text-slate-300 mb-1.5 tracking-wider uppercase">
                            <%= typeof t !== 'undefined' ? t('contact.nameLabel') : 'YOUR FULL NAME' %>
                        </label>
                        <input type="text" id="contact-name" required placeholder="<%= typeof t !== 'undefined' ? t('contact.namePlaceholder') : 'Full Name' %>" class="w-full bg-slate-900/80 border border-white/15 rounded-xl px-4 py-3 text-white placeholder-slate-500 text-xs sm:text-sm focus:outline-none focus:border-cyan-400 focus:shadow-[0_0_15px_rgba(0,229,255,0.3)] transition-all">
                    </div>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-mono font-bold text-slate-300 mb-1.5 tracking-wider uppercase">
                                <%= typeof t !== 'undefined' ? t('contact.emailLabel') : 'EMAIL ADDRESS' %>
                            </label>
                            <input type="email" id="contact-email" required placeholder="<%= typeof t !== 'undefined' ? t('contact.emailPlaceholder') : 'name@example.com' %>" class="w-full bg-slate-900/80 border border-white/15 rounded-xl px-4 py-3 text-white placeholder-slate-500 text-xs sm:text-sm focus:outline-none focus:border-cyan-400 focus:shadow-[0_0_15px_rgba(0,229,255,0.3)] transition-all">
                        </div>
                        <div>
                            <label class="block text-xs font-mono font-bold text-slate-300 mb-1.5 tracking-wider uppercase">
                                <%= typeof t !== 'undefined' ? t('contact.phoneLabel') : 'PHONE NUMBER' %>
                            </label>
                            <input type="tel" id="contact-phone" placeholder="<%= typeof t !== 'undefined' ? t('contact.phonePlaceholder') : '(240) 555-0199' %>" class="w-full bg-slate-900/80 border border-white/15 rounded-xl px-4 py-3 text-white placeholder-slate-500 text-xs sm:text-sm focus:outline-none focus:border-cyan-400 focus:shadow-[0_0_15px_rgba(0,229,255,0.3)] transition-all">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-mono font-bold text-slate-300 mb-1.5 tracking-wider uppercase">
                            <%= typeof t !== 'undefined' ? t('contact.interestLabel') : 'HOW CAN WE HELP YOU?' %>
                        </label>
                        <select id="contact-interest" class="w-full bg-slate-900/80 border border-white/15 rounded-xl px-4 py-3 text-white text-xs sm:text-sm focus:outline-none focus:border-cyan-400 transition-colors">
                            <option value="gathering" class="bg-slate-900 text-white"><%= typeof t !== 'undefined' ? t('contact.interest.gathering') : 'Attending a Tuesday Gathering' %></option>
                            <option value="smallgroup" class="bg-slate-900 text-white"><%= typeof t !== 'undefined' ? t('contact.interest.smallgroup') : 'Joining a Small Group Life Pod' %></option>
                            <option value="serving" class="bg-slate-900 text-white"><%= typeof t !== 'undefined' ? t('contact.interest.serving') : 'Serving Opportunities' %></option>
                            <option value="prayer" class="bg-slate-900 text-white"><%= typeof t !== 'undefined' ? t('contact.interest.prayer') : 'Prayer Request' %></option>
                            <option value="other" class="bg-slate-900 text-white"><%= typeof t !== 'undefined' ? t('contact.interest.other') : 'General Question' %></option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-mono font-bold text-slate-300 mb-1.5 tracking-wider uppercase">
                            <%= typeof t !== 'undefined' ? t('contact.messageLabel') : 'YOUR MESSAGE' %>
                        </label>
                        <textarea id="contact-notes" rows="3" placeholder="<%= typeof t !== 'undefined' ? t('contact.messagePlaceholder') : 'Tell us a bit about yourself or how we can pray for you...' %>" class="w-full bg-slate-900/80 border border-white/15 rounded-xl p-4 text-white placeholder-slate-500 text-xs sm:text-sm focus:outline-none focus:border-cyan-400 focus:shadow-[0_0_15px_rgba(0,229,255,0.3)] transition-all resize-none"></textarea>
                    </div>

                    <!-- Explicit Privacy & Age Consents -->
                    <div class="space-y-2 pt-1 text-left">
                        <label class="flex items-start gap-2.5 cursor-pointer select-none">
                            <input type="checkbox" id="contact-consent" required class="mt-0.5 w-3.5 h-3.5 rounded border-white/20 text-cyan-400 focus:ring-cyan-400">
                            <span class="text-xs text-slate-300 leading-normal">
                                I consent to Emmanuel United Church of MD storing my contact details to reply to my inquiry in accordance with the <a href="/privacy" target="_blank" class="text-cyan-300 underline font-medium">Privacy Policy</a>.
                            </span>
                        </label>
                        <label class="flex items-start gap-2.5 cursor-pointer select-none">
                            <input type="checkbox" id="contact-age-consent" required class="mt-0.5 w-3.5 h-3.5 rounded border-white/20 text-cyan-400 focus:ring-cyan-400">
                            <span class="text-xs text-slate-300 leading-normal">
                                I confirm I am 18 years of age or older (or 13–17 with parental/guardian permission).
                            </span>
                        </label>
                    </div>
                    
                    <div id="contact-success" class="hidden bg-cyan-400/10 border border-cyan-400/40 text-cyan-200 rounded-xl p-4 text-xs font-medium flex items-center gap-3">
                        <span class="text-cyan-400 font-bold text-base">✓</span>
                        <span><%= typeof t !== 'undefined' ? t('contact.success') : 'Thank you! Your message has been received. A ministry leader will connect with you shortly.' %></span>
                    </div>

                    <button type="submit" id="contact-submit" class="azure-primary-btn w-full min-h-[48px] text-xs uppercase tracking-wider flex items-center justify-center gap-2">
                        <span><%= typeof t !== 'undefined' ? t('contact.submitBtn') : 'Send Note & Connect' %></span>
                        <span aria-hidden="true">&rarr;</span>
                    </button>
                </form>
            </div>
        </div>
    </section>
