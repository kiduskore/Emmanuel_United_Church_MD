        <!-- Outreach Lightbox Modal -->
        <div id="outreach-lightbox-modal" class="fixed inset-0 z-[200] hidden items-center justify-center p-3 sm:p-6 bg-black/95 backdrop-blur-3xl transition-opacity duration-300" role="dialog" aria-modal="true" aria-label="Outreach Photo Lightbox">
            <div class="relative w-full max-w-5xl max-h-[92vh] flex flex-col items-center justify-center">
                <!-- Close Button -->
                <button type="button" onclick="window.closeOutreachLightbox && window.closeOutreachLightbox()" class="absolute -top-12 right-0 sm:right-2 p-2.5 rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors cursor-pointer z-50" aria-label="Close lightbox">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>

                <!-- Navigation Previous Button -->
                <button type="button" onclick="window.prevOutreachPhoto && window.prevOutreachPhoto()" class="absolute left-2 sm:-left-12 top-1/2 -translate-y-1/2 p-3 rounded-full bg-black/60 hover:bg-black/90 text-white border border-white/20 transition-all cursor-pointer z-50" aria-label="Previous photo">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                </button>

                <!-- Navigation Next Button -->
                <button type="button" onclick="window.nextOutreachPhoto && window.nextOutreachPhoto()" class="absolute right-2 sm:-right-12 top-1/2 -translate-y-1/2 p-3 rounded-full bg-black/60 hover:bg-black/90 text-white border border-white/20 transition-all cursor-pointer z-50" aria-label="Next photo">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </button>

                <!-- Image Container -->
                <div class="relative w-full rounded-2xl overflow-hidden border border-sky-400/40 shadow-2xl bg-black flex items-center justify-center max-h-[75vh]">
                    <img id="outreach-lightbox-img" src="" alt="Outreach Photo" class="max-h-[75vh] w-auto max-w-full object-contain">
                </div>

                <!-- Caption Bar -->
                <div class="w-full mt-4 p-4 rounded-2xl bg-[#08152e]/90 border border-sky-400/30 text-center text-white backdrop-blur-xl">
                    <div class="flex items-center justify-between mb-1">
                        <span id="outreach-lightbox-category" class="text-[11px] font-heading font-bold uppercase tracking-widest text-cyan-300">Outreach Photo</span>
                        <span id="outreach-lightbox-counter" class="text-xs font-mono text-sky-300">Photo 1 of 11</span>
                    </div>
                    <h3 id="outreach-lightbox-title" class="text-lg font-heading font-bold uppercase text-white">Title</h3>
                    <p id="outreach-lightbox-desc" class="text-xs text-sky-200/80 font-sans mt-0.5">Description</p>
                </div>
            </div>
        </div>

        <script>
        (function() {
            const outreachPhotos = [
                {
                    src: "/assets/aistudio/7bf8c88b-0eda-42cc-9c9f-917d28b880c6.JPG",
                    title: "The Way, The Truth, The Life (John 14:6)",
                    category: "Full Outreach Team",
                    desc: "Emmanuel United Church evangelism team gathered in downtown Silver Spring under golden autumn ginkgo trees with Christ scripture banner."
                },
                {
                    src: "/assets/aistudio/7c245220-c7aa-4c8e-b51e-59798eb9def6.JPG",
                    title: "Street Evangelism with Pastor Dr. Bezalem Fisseha",
                    category: "Pastor & Outreach",
                    desc: "Pastor Dr. Bezalem sharing gospel tracts with passersby alongside sister wearing 'NOT ASHAMED - ROMANS 1:16' cross cape."
                },
                {
                    src: "/assets/aistudio/1e774192-81c3-431d-ae6f-342df0c5227e.JPG",
                    title: "ኢየሱስ ጌታ ነው! (Jesus is Lord)",
                    category: "Amharic Proclamation",
                    desc: "Brother holding high-visibility Amharic chalkboard gospel sign on the downtown Silver Spring pedestrian civic plaza."
                },
                {
                    src: "/assets/aistudio/c316c200-7d7d-489c-86df-097aedfeeac6.JPG",
                    title: "Jesus Saves Crosswalk Ministry",
                    category: "Street Witness",
                    desc: "Lifting the bold yellow 'JESUS SAVES' gospel sign high above the crosswalk on the bustling corner of downtown Silver Spring."
                },
                {
                    src: "/assets/aistudio/da33096c-b6cb-4bce-b8d3-e3d70924b049.JPG",
                    title: "Crosswalk Christ Banner Proclamation",
                    category: "Gospel Witness",
                    desc: "Holding the wide Christ banner with the red cross across the Silver Spring intersection while offering prayer."
                },
                {
                    src: "/assets/aistudio/593d3e63-d81c-435d-abe4-2d5f5df311ac.JPG",
                    title: "Multilingual Gospel Flag",
                    category: "Nations Outreach",
                    desc: "Waving scripture flag ('耶穌是道路、真理、生命' - Chinese, Arabic, English, Amharic) along the Silver Spring walkway."
                },
                {
                    src: "/assets/aistudio/08ba735a-ebbb-4d83-94df-15d6c56a89ec.JPG",
                    title: "United for the Great Commission",
                    category: "Team Fellowship",
                    desc: "Men, women, youth, and children of EUC Maryland taking the love and hope of Jesus to our city."
                },
                {
                    src: "/assets/aistudio/96b4fdba-fc17-4b33-9f71-060eecbab731.JPG",
                    title: "Civic Plaza Unashamed Proclamation",
                    category: "Plaza Witness",
                    desc: "Standing boldly for the Lord with 'ኢየሱስ ጌታ ነው!' banner in front of downtown shops and restaurants."
                },
                {
                    src: "/assets/aistudio/dc60e8a7-7d76-49c9-8e10-2010272877dd.JPG",
                    title: "Autumn Gospel Outreach in the City",
                    category: "Downtown Mission",
                    desc: "Spreading the message of Christ to shoppers, commuters, and families across Silver Spring."
                },
                {
                    src: "/assets/aistudio/0361da65-97a4-4a1f-ab9a-789c7fd366d8.JPG",
                    title: "Joy of the Harvest in the DMV",
                    category: "Joyful Witness",
                    desc: "Spreading the warmth and love of Christ with joyful smiles, prayer, and one-on-one witnessing."
                },
                {
                    src: "/assets/aistudio/28093540-9470-441a-a106-765642bcd165.JPG",
                    title: "Romans 1:16 Commissioning & Fellowship",
                    category: "Commissioned",
                    desc: "Outreach team giving God the glory following a powerful afternoon of seed-planting and prayer in the community."
                }
            ];

            let activeIndex = 0;

            window.openOutreachLightbox = function(index) {
                activeIndex = (index >= 0 && index < outreachPhotos.length) ? index : 0;
                const modal = document.getElementById('outreach-lightbox-modal');
                if (!modal) return;
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                document.body.style.overflow = 'hidden';
                updateLightboxContent();
            };

            window.closeOutreachLightbox = function() {
                const modal = document.getElementById('outreach-lightbox-modal');
                if (!modal) return;
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                document.body.style.overflow = '';
            };

            window.prevOutreachPhoto = function() {
                activeIndex = (activeIndex - 1 + outreachPhotos.length) % outreachPhotos.length;
                updateLightboxContent();
            };

            window.nextOutreachPhoto = function() {
                activeIndex = (activeIndex + 1) % outreachPhotos.length;
                updateLightboxContent();
            };

            function updateLightboxContent() {
                const item = outreachPhotos[activeIndex];
                const img = document.getElementById('outreach-lightbox-img');
                const title = document.getElementById('outreach-lightbox-title');
                const cat = document.getElementById('outreach-lightbox-category');
                const desc = document.getElementById('outreach-lightbox-desc');
                const counter = document.getElementById('outreach-lightbox-counter');

                if (img) img.src = item.src;
                if (title) title.textContent = item.title;
                if (cat) cat.textContent = item.category;
                if (desc) desc.textContent = item.desc;
                if (counter) counter.textContent = `Photo ${activeIndex + 1} of ${outreachPhotos.length}`;
            }

            document.addEventListener('keydown', function(e) {
                const modal = document.getElementById('outreach-lightbox-modal');
                if (!modal || modal.classList.contains('hidden')) return;
                if (e.key === 'Escape') window.closeOutreachLightbox();
                if (e.key === 'ArrowLeft') window.prevOutreachPhoto();
                if (e.key === 'ArrowRight') window.nextOutreachPhoto();
            });
        })();
        </script>

    </div>

</main>

