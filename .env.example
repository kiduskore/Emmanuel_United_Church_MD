# ==============================================================================
# Emmanuel United Church of Maryland (EUCMD) — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database & Session Keys
# ------------------------------------------------------------------------------
# DATABASE_URL:
# Optional PostgreSQL connection string (e.g. postgresql://user:password@host:5432/dbname).
# Recommendation: Optional. The application uses local persistent file storage (data.json)
# to store members, DNA pods, events, and prayer requests. You can leave this blank or
# input a PostgreSQL URL if you have an external database.
DATABASE_URL=

# SESSION_SECRET:
# A secure random secret string used to sign session cookies.
# Default fallback: euc_ya_management_secret_key_2026
SESSION_SECRET=euc_ya_management_secret_key_2026

# ------------------------------------------------------------------------------
# 2. Email / SMTP Configuration (Welcome & Password Reset Emails)
# ------------------------------------------------------------------------------
# SMTP_HOST / SMTP_SERVER:
#   For IONOS: smtp.ionos.com
#   For Gmail: smtp.gmail.com
#   For Outlook / Office 365: smtp.office365.com
SMTP_HOST=smtp.ionos.com
SMTP_SERVER=smtp.ionos.com

# SMTP_PORT:
#   587 (Standard TLS / STARTTLS)
#   465 (Direct SSL)
SMTP_PORT=587

# SMTP_SECURE:
#   false for port 587 (STARTTLS upgraded)
#   true for port 465 (Direct SSL)
SMTP_SECURE=false

# SMTP_USER:
#   Sending email address (e.g., info@eucmaryland.org or your church email address)
SMTP_USER=

# SMTP_PASS:
#   Email account password or Google / Microsoft App-Specific Password
SMTP_PASS=

# ------------------------------------------------------------------------------
# 3. Optional Cloud SQL / PostgreSQL Direct Keys
# ------------------------------------------------------------------------------
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Optional AI / Gemini API Key
# ------------------------------------------------------------------------------
GEMINI_API_KEY=