<%- include('partials/header', { metaTitle: 'Leader Login | Emmanuel United Church of MD' }) %>
<%- include('partials/navbar') %>

<div class="min-h-screen flex items-center justify-center p-4 relative overflow-hidden pt-28 pb-20">
    <!-- Ambient Celestial Aurora Spotlight Gradients -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
        <div class="absolute top-[10%] left-[25%] w-[600px] h-[600px] bg-sky-500/15 rounded-full filter blur-[140px]"></div>
        <div class="absolute bottom-[20%] right-[15%] w-[500px] h-[500px] bg-cyan-400/20 rounded-full filter blur-[140px]"></div>
        <div class="absolute top-[35%] right-[25%] w-[450px] h-[450px] bg-blue-600/15 rounded-full filter blur-[120px]"></div>
    </div>
    
    <div class="w-full max-w-md p-8 sm:p-10 relative z-10 text-center azure-glass-shell rounded-[2.5rem] shadow-2xl border border-sky-400/30">
        <div class="diamond-glint -top-4 -right-4 pointer-events-none"></div>

        <div class="flex justify-center mb-6">
            <div class="w-20 h-20 rounded-3xl bg-white/95 p-1.5 flex items-center justify-center shadow-[0_0_30px_rgba(56,189,248,0.5)] border border-sky-300/40 overflow-hidden">
                <img src="/static/euc_church_logo.png" alt="Emmanuel United Church Logo" class="w-full h-full object-contain">
            </div>
        </div>
        
        <h2 class="text-2xl sm:text-3xl font-black mb-2 tracking-tight font-heading text-white">
            <%= typeof t !== 'undefined' ? t('auth.welcomeBack') : 'Welcome Back' %>
        </h2>
        <p class="text-sky-200/80 text-xs sm:text-sm mb-6 font-sans">
            <%= typeof t !== 'undefined' ? t('auth.signInDashboard') : 'Sign in to the Church Management Dashboard' %>
        </p>

        <!-- ⚡ 1-CLICK INSTANT BYPASS BUTTONS FOR TESTING -->
        <div class="mb-6 p-4 rounded-2xl azure-inner-card border border-sky-400/25 text-left backdrop-blur-xl">
            <div class="flex items-center justify-between mb-2.5">
                <span class="text-[11px] font-heading font-extrabold uppercase tracking-widest text-cyan-300 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse shadow-[0_0_8px_#22d3ee]"></span>
                    Instant 1-Click Access
                </span>
                <span class="text-[10px] text-sky-200/60 font-medium">No typing needed</span>
            </div>
            <div class="grid grid-cols-2 gap-2.5">
                <a href="/auth/quick-login?role=admin" class="py-2.5 px-3 rounded-xl azure-primary-btn text-slate-950 font-heading font-black text-xs text-center shadow-lg block transition-all active:scale-95">
                    👑 Sign In as Admin
                </a>
                <a href="/auth/quick-login?role=leader" class="py-2.5 px-3 rounded-xl bg-sky-950/70 hover:bg-sky-900/80 border border-sky-400/30 text-white font-heading font-bold text-xs text-center block transition-all active:scale-95">
                    👤 Sign In as Leader
                </a>
            </div>
            <div class="mt-2.5 pt-2 border-t border-sky-400/15 flex items-center justify-between text-[11px] text-sky-200/70 font-mono">
                <span>User: <strong class="text-white">admin@euc.org</strong></span>
                <span>Pass: <strong class="text-white">password123</strong></span>
            </div>
        </div>
        
        <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-rose-500/20 border border-rose-500/40 text-rose-200 rounded-xl p-3 text-xs sm:text-sm mb-6 text-left">
            <%= error %>
        </div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
        <div class="bg-emerald-500/20 border border-emerald-500/40 text-emerald-200 rounded-xl p-3 text-xs sm:text-sm mb-6 text-left">
            <%= success %>
        </div>
        <% } %>
        
        <% if (typeof alreadySignedIn !== "undefined" && alreadySignedIn) { %>
            <div class="bg-sky-500/20 border border-sky-400/40 text-sky-200 p-6 rounded-2xl text-center mb-6">
                <p class="font-bold mb-4">You are already signed in.</p>
                <a href="/dashboard" class="inline-block azure-primary-btn text-slate-950 font-black py-2.5 px-6 rounded-xl transition-all">Go to Dashboard</a>
            </div>
        <% } else { %>
            <form method="POST" action="/login" class="space-y-4 text-left">
                <input type="hidden" name="csrf_token" value="<%= typeof csrf_token !== 'undefined' ? csrf_token : '' %>">
                <div>
                    <label class="block text-xs font-bold text-sky-200/80 mb-1.5 tracking-wide uppercase font-heading">
                        <%= typeof t !== 'undefined' ? t('auth.email') : 'Email or Username' %>
                    </label>
                    <input type="text" name="email" id="login-identifier" autocapitalize="none" autocorrect="off" autocomplete="username" placeholder="admin@euc.org or admin" value="admin@euc.org" required class="w-full bg-[#060d1d]/80 border border-sky-400/25 text-white placeholder-sky-300/30 rounded-xl p-3.5 outline-none focus:ring-2 focus:ring-cyan-400/50 focus:border-cyan-400 transition-all font-medium text-sm">
                </div>
                <div>
                    <div class="flex justify-between items-center mb-1.5">
                        <label class="block text-xs font-bold text-sky-200/80 tracking-wide uppercase font-heading">
                            <%= typeof t !== 'undefined' ? t('auth.password') : 'Password' %>
                        </label>
                        <a href="/forgot-password" class="text-xs font-semibold text-cyan-300 hover:text-cyan-200 transition-colors">
                            <%= typeof t !== 'undefined' ? t('auth.forgotPassword') : 'Forgot password?' %>
                        </a>
                    </div>
                    <input type="password" name="password" id="login-password" autocomplete="current-password" placeholder="password123" value="password123" required class="w-full bg-[#060d1d]/80 border border-sky-400/25 text-white placeholder-sky-300/30 rounded-xl p-3.5 outline-none focus:ring-2 focus:ring-cyan-400/50 focus:border-cyan-400 transition-all font-medium text-sm">
                </div>
                
                <button type="submit" class="w-full azure-primary-btn text-slate-950 font-heading font-black rounded-xl p-3.5 mt-2 transition-transform hover:scale-[1.02] active:scale-[0.98] uppercase tracking-wider text-xs">
                    <%= typeof t !== 'undefined' ? t('auth.signIn') : 'Sign In With Credentials' %>
                </button>
            </form>
        <% } %>
        
        <div class="mt-6 text-xs text-sky-200/70 border-t border-sky-400/15 pt-4">
            <%= typeof t !== 'undefined' ? t('auth.haveSignupCode') : 'Have a signup code?' %> 
            <a href="/claim-account" class="text-cyan-300 hover:text-cyan-200 font-bold ml-1">
                <%= typeof t !== 'undefined' ? t('auth.claimAccount') : 'Claim account' %>
            </a>
        </div>
        
        <div class="mt-4">
            <a href="/" class="text-xs font-semibold text-sky-300/80 hover:text-white transition-colors flex items-center justify-center gap-1.5">
                <span>&larr;</span> <%= typeof t !== 'undefined' ? t('common.backToPublic') : 'Back to Website' %>
            </a>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
