            <div class="relative bg-[#030712] flex items-center justify-center p-2 sm:p-4 max-h-[70vh] overflow-hidden">
                <img id="family-lightbox-img" src="" alt="" class="max-h-[65vh] max-w-full w-auto h-auto rounded-xl object-contain shadow-2xl" referrerPolicy="no-referrer">

                <button type="button" onclick="window.prevFamilyPhoto && window.prevFamilyPhoto()" class="absolute left-3 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-black/70 hover:bg-cyan-500/40 border border-white/25 text-white flex items-center justify-center transition-all cursor-pointer backdrop-blur-md active:scale-90" aria-label="Previous photo">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path></svg>
                </button>
                <button type="button" onclick="window.nextFamilyPhoto && window.nextFamilyPhoto()" class="absolute right-3 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-black/70 hover:bg-cyan-500/40 border border-white/25 text-white flex items-center justify-center transition-all cursor-pointer backdrop-blur-md active:scale-90" aria-label="Next photo">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
