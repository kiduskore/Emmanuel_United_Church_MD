<%- include('partials/header', { 
    metaTitle: 'Authentic Christian Community & DNA Pods | EUCMD Young Adults',
    metaDesc: 'Experience Christ-centered fellowship, prayer partners, and weekly life groups for college students and young professionals in Maryland.',
    currentPath: '/community'
}) %>
<%- include('partials/navbar') %>

<main class="min-h-screen text-white pt-24 pb-20 selection:bg-cyan-500 selection:text-black relative overflow-hidden">

    <!-- Ambient Cosmic Spotlight Beams -->
    <div class="pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[550px] bg-gradient-to-b from-cyan-400/20 via-sky-500/10 to-transparent blur-3xl -z-10"></div>
    <div class="pointer-events-none absolute top-1/3 -left-32 w-96 h-96 bg-sky-500/15 rounded-full blur-3xl -z-10"></div>
    <div class="pointer-events-none absolute top-2/3 -right-32 w-96 h-96 bg-cyan-400/15 rounded-full blur-3xl -z-10"></div>

    <!-- Header Section -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-10 text-center">
        <div class="azure-glass-shell p-8 sm:p-12 relative overflow-hidden">
            <div class="diamond-glint" style="top: 2rem; right: 3rem;"></div>
            
            <div class="azure-pill inline-flex items-center gap-2 mb-4">
                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
                <span><%= typeof t !== 'undefined' ? t('community.heroSubtitle') : 'A Family Within the Family' %></span>
            </div>

            <h1 class="text-4xl sm:text-6xl font-heading font-black tracking-tight uppercase text-white mb-4">
                <%= typeof t !== 'undefined' ? t('community.heroTitle') : 'Community & Fellowship' %>
            </h1>

            <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
                "Grow bigger, stay closer." Everyone known, everyone loved, everyone prayed for in authentic circles.
            </p>
        </div>
    </section>

    <!-- Main Content Shell -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
        <div class="azure-glass-shell p-8 sm:p-12 relative overflow-hidden space-y-10">
            <div class="diamond-glint" style="bottom: 2rem; right: 2rem;"></div>

            <!-- Read time & Header title -->
            <div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 pb-6">
                <div>
                    <span class="px-3 py-1 rounded-full bg-cyan-400/10 border border-cyan-400/30 text-cyan-300 font-mono text-xs uppercase tracking-wider">
                        <%= typeof t !== 'undefined' ? t('common.readTime', { min: '3' }) : '3 MIN READ' %>
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-heading font-bold text-white uppercase tracking-tight mt-3">
                        <%= typeof t !== 'undefined' ? t('community.title') : 'Grow Bigger, Stay Closer' %>
                    </h2>
                </div>
                <div class="w-24 h-1 rounded-full cyan-progress-fill"></div>
            </div>

            <!-- Core Principle -->
            <div class="space-y-4">
                <h3 class="text-xl font-heading font-bold uppercase text-white flex items-center gap-2">
                    <span class="text-cyan-400">✦</span>
                    <span>Our Core Principle</span>
                </h3>
                <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
                    As our Bible study and church family grows, we don't want people to become numbers. We want:
                </p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                    <div class="azure-inner-card p-4 flex items-center gap-3">
                        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                        <span class="text-white text-sm font-medium">Everyone to be known</span>
                    </div>
                    <div class="azure-inner-card p-4 flex items-center gap-3">
                        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                        <span class="text-white text-sm font-medium">Everyone to be welcomed</span>
                    </div>
                    <div class="azure-inner-card p-4 flex items-center gap-3">
                        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                        <span class="text-white text-sm font-medium">Everyone to have someone praying for them</span>
                    </div>
                    <div class="azure-inner-card p-4 flex items-center gap-3">
                        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                        <span class="text-white text-sm font-medium">Everyone to have a place to belong</span>
                    </div>
                </div>

                <div class="azure-inner-card p-5 border-l-4 border-l-cyan-400 mt-4">
                    <p class="text-cyan-200 text-sm sm:text-base italic leading-relaxed">
                        "Growth should increase our capacity — not decrease our intimacy. No one should come to church or Bible study and feel like a stranger."
                    </p>
                </div>
            </div>

            <!-- DNA PODS SECTION -->
            <div class="azure-inner-card p-6 sm:p-8 space-y-6 border border-cyan-400/30 shadow-[0_0_25px_rgba(0,229,255,0.15)]">
                <div class="flex items-center gap-3">
                    <span class="text-3xl">🌱</span>
                    <div>
                        <span class="text-xs font-mono font-bold uppercase tracking-wider text-cyan-400 block">Discipleship Circles</span>
                        <h3 class="text-xl sm:text-2xl font-heading font-black text-white uppercase tracking-tight">DNA Pods (Small Group Discipleship)</h3>
                    </div>
                </div>

                <div class="p-4 rounded-xl bg-white/[0.04] border border-white/10 space-y-1">
                    <span class="text-xs font-mono font-bold uppercase tracking-wider text-cyan-300 block">Current Pod Facilitators</span>
                    <p class="text-slate-200 text-sm leading-relaxed">
                        <strong class="text-white">Bercy, Biniyam, Gedi, Ela, Kidus, Nahom, Fiker, and Kal</strong> (serving as primary facilitators for their respective groups).
                    </p>
                </div>

                <div class="space-y-2">
                    <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-300">Core Responsibilities</h4>
                    <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
                        Facilitate consistent, tight-knit community and spiritual growth within your assigned group. You are responsible for regular check-ins, guiding discussions (applying the Tuesday Bible study and Sunday teachings), offering spiritual care, and ensuring every member feels known and supported.
                    </p>
                </div>

                <!-- Current DNA Pod Rosters -->
                <div>
                    <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-cyan-300 mb-4">Current DNA Pod Rosters</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        
                        <!-- Pod 1 -->
                        <div class="p-4 rounded-xl bg-black/40 border border-white/10 space-y-2">
                            <div class="flex items-center justify-between">
                                <strong class="text-sm font-heading uppercase text-white font-bold">DNA Pod 1</strong>
                                <span class="text-xs font-mono text-cyan-400">Leads: Bercy &amp; Kal</span>
                            </div>
                            <div class="flex flex-wrap gap-1.5 pt-1">
                                <span class="px-2.5 py-1 rounded-lg bg-cyan-400/20 text-xs text-cyan-200 font-medium">Bercy</span>
                                <span class="px-2.5 py-1 rounded-lg bg-cyan-400/20 text-xs text-cyan-200 font-medium">Kal</span>
                                <span class="px-2.5 py-1 rounded-lg bg-white/10 text-xs text-slate-300">Dibora</span>
                                <span class="px-2.5 py-1 rounded-lg bg-white/10 text-xs text-slate-300">Dula</span>
                                <span class="px-2.5 py-1 rounded-lg bg-white/10 text-xs text-slate-300">Kaleb</span>
                                <span class="px-2.5 py-1 rounded-lg bg-white/10 text-xs text-slate-300">Kana</span>
                                <span class="px-2.5 py-1 rounded-lg bg-white/10 text-xs text-slate-300">Abigiya</span>
                            </div>
                        </div>

                        <!-- Pod 2 -->
                        <div class="p-4 rounded-xl bg-black/40 border border-white/10 space-y-2">
                            <div class="flex items-center justify-between">
                                <strong class="text-sm font-heading uppercase text-white font-bold">DNA Pod 2</strong>
                                <span class="text-xs font-mono text-cyan-400">Leads: Biniyam &amp; Fiker</span>
                            </div>
                            <div class="flex flex-wrap gap-1.5 pt-1">
                                <span class="px-2.5 py-1 rounded-lg bg-cyan-400/20 text-xs text-cyan-200 font-medium">Biniyam</span>
                                <span class="px-2.5 py-1 rounded-lg bg-cyan-400/20 text-xs text-cyan-200 font-medium">Fiker</span>
                                <span class="px-2.5 py-1 rounded-lg bg-white/10 text-xs text-slate-300">Tsion</span>
                                <span class="px-2.5 py-1 rounded-lg bg-white/10 text-xs text-slate-300">Josh</span>
                                <span class="px-2.5 py-1 rounded-lg bg-white/10 text-xs text-slate-300">Meeraf</span>
                            </div>
                        </div>

                        <!-- Pod 3 -->
                        <div class="p-4 rounded-xl bg-black/40 border border-white/10 space-y-2">
                            <div class="flex items-center justify-between">
                                <strong class="text-sm font-heading uppercase text-white font-bold">DNA Pod 3</strong>
                                <span class="text-xs font-mono text-cyan-400">Leads: Gedi &amp; Nahom</span>
                            </div>
                            <div class="flex flex-wrap gap-1.5 pt-1">
                                <span class="px-2.5 py-1 rounded-lg bg-cyan-400/20 text-xs text-cyan-200 font-medium">Gedi</span>
                                <span class="px-2.5 py-1 rounded-lg bg-cyan-400/20 text-xs text-cyan-200 font-medium">Nahom</span>
                                <span class="px-2.5 py-1 rounded-lg bg-white/10 text-xs text-slate-300">Ruth</span>
                                <span class="px-2.5 py-1 rounded-lg bg-white/10 text-xs text-slate-300">Zetseat</span>
                                <span class="px-2.5 py-1 rounded-lg bg-white/10 text-xs text-slate-300">Miki</span>
                            </div>
                        </div>

                        <!-- Pod 4 -->
                        <div class="p-4 rounded-xl bg-black/40 border border-white/10 space-y-2">
                            <div class="flex items-center justify-between">
                                <strong class="text-sm font-heading uppercase text-white font-bold">DNA Pod 4</strong>
                                <span class="text-xs font-mono text-cyan-400">Leads: Ela &amp; Kidus</span>
                            </div>
                            <div class="flex flex-wrap gap-1.5 pt-1">
                                <span class="px-2.5 py-1 rounded-lg bg-cyan-400/20 text-xs text-cyan-200 font-medium">Ela</span>
                                <span class="px-2.5 py-1 rounded-lg bg-cyan-400/20 text-xs text-cyan-200 font-medium">Kidus</span>
                                <span class="px-2.5 py-1 rounded-lg bg-white/10 text-xs text-slate-300">Yezich</span>
                                <span class="px-2.5 py-1 rounded-lg bg-white/10 text-xs text-slate-300">Eden</span>
                                <span class="px-2.5 py-1 rounded-lg bg-white/10 text-xs text-slate-300">Miki</span>
                                <span class="px-2.5 py-1 rounded-lg bg-white/10 text-xs text-slate-300">Regan</span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Fellowship Beyond Gatherings -->
            <div class="space-y-4 pt-4 border-t border-white/10">
                <h3 class="text-xl font-heading font-bold uppercase text-white flex items-center gap-2">
                    <span class="text-cyan-400">✦</span>
                    <span>Fellowship Beyond Weekly Gatherings</span>
                </h3>
                <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
                    We grow around the table. Faith shouldn't only happen inside the sanctuary. Our fellowship includes community brunches, game nights, annual retreats, service projects, birthday celebrations, and small group dinners across Maryland and the DMV.
                </p>
            </div>

            <!-- Call to action button -->
            <div class="pt-6">
                <a href="/join" class="azure-primary-btn w-full block text-center py-4 text-sm uppercase tracking-wider">
                    <%= typeof t !== 'undefined' ? t('community.ctaBtn') : 'Join a Small Group' %> &rarr;
                </a>
            </div>

        </div>
    </section>

</main>

<%- include('partials/footer') %>
